@model IshikawaRca.Contracts.Rca.RcaExternalIntakeDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Respuesta enviada</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="external-intake-body">
    <main class="external-intake-shell">
        <section class="external-intake-header">
            <span class="brand-mark">IR</span>
            <div>
                <p class="module-kicker">@Model.ActorType</p>
                <h1>Respuesta enviada</h1>
                <p>@Model.IncidentTitle</p>
            </div>
            <span class="status-chip">@Model.Status</span>
        </section>

        <section class="empty-state premium-empty">
            <span class="empty-symbol">OK</span>
            <h2>Gracias. La respuesta quedo pendiente de revision interna.</h2>
            <p>El equipo responsable revisara la informacion antes de incorporarla al RCA oficial.</p>
        </section>
    </main>
</body>
</html>
