@model IReadOnlyList<IshikawaRca.Contracts.Rca.RcaIncidentDto>

@{
    ViewData["Title"] = "Incidentes RCA";
}

<section class="page-heading">
    <div>
        <p class="module-kicker">Standalone</p>
        <h1>Incidentes RCA</h1>
        <p>Alta y seguimiento inicial de analisis Ishikawa creados manualmente o por integraciones futuras.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Rca" asp-action="Create">Nuevo incidente</a>
</section>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<section class="table-panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h2>No hay incidentes RCA cargados</h2>
            <p>Empeza creando un incidente manual. Mas adelante tambien entraran eventos desde Gantt, SCADA, Andon, TPM u OEE.</p>
            <a class="btn btn-primary" asp-controller="Rca" asp-action="Create">Crear primer incidente</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle module-table">
                <thead>
                    <tr>
                        <th>Problema</th>
                        <th>Origen</th>
                        <th>Severidad</th>
                        <th>Estado</th>
                        <th>Maquina</th>
                        <th>Creado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var incident in Model)
                {
                    <tr>
                        <td>
                            <strong>@incident.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(incident.ProblemDescription))
                            {
                                <span>@incident.ProblemDescription</span>
                            }
                        </td>
                        <td>@incident.SourceSystem</td>
                        <td><span class="severity-pill severity-@incident.Severity.ToLowerInvariant()">@incident.Severity</span></td>
                        <td>@incident.Status</td>
                        <td>@(incident.MachineCode ?? "-")</td>
                        <td>@incident.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Rca" asp-action="Details" asp-route-id="@incident.Id">Ver</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
