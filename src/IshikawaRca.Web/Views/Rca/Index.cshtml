@model IReadOnlyList<IshikawaRca.Contracts.Rca.RcaIncidentDto>

@{
    ViewData["Title"] = "Incidentes RCA";
    var openCount = Model.Count(x => string.Equals(x.Status, "Open", StringComparison.OrdinalIgnoreCase));
    var highCount = Model.Count(x => string.Equals(x.Severity, "High", StringComparison.OrdinalIgnoreCase) || string.Equals(x.Severity, "Critical", StringComparison.OrdinalIgnoreCase));
    var externalClaimCount = Model.Count(x => string.Equals(x.ClaimScope, "External", StringComparison.OrdinalIgnoreCase));
}

<section class="page-heading premium-heading">
    <div>
        <p class="module-kicker">RCA Control Center</p>
        <h1>Incidentes RCA</h1>
        <p>Seguimiento operativo de analisis Ishikawa creados manualmente o por integraciones externas.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Rca" asp-action="Create">Nuevo incidente</a>
</section>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success premium-alert" role="status">@message</div>
}

<section class="metric-grid compact-metrics" aria-label="Resumen de incidentes">
    <article class="metric-tile">
        <span class="metric-value">@Model.Count</span>
        <strong>Total RCA</strong>
        <p>Incidentes registrados.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@openCount</span>
        <strong>Abiertos</strong>
        <p>Analisis en curso.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@highCount</span>
        <strong>Alta prioridad</strong>
        <p>Severidad High o Critical.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@externalClaimCount</span>
        <strong>Externos</strong>
        <p>Reclamos asociados a cliente.</p>
    </article>
</section>

<section class="table-panel premium-table-panel">
    <div class="panel-heading table-heading">
        <div>
            <h2>Tablero de seguimiento</h2>
            <span>Ultimos incidentes RCA registrados</span>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state premium-empty">
            <span class="empty-symbol">RCA</span>
            <h2>No hay incidentes cargados</h2>
            <p>Empeza con un RCA manual. Despues entraran eventos desde Gantt, SCADA, Andon, TPM u OEE.</p>
            <a class="btn btn-primary" asp-controller="Rca" asp-action="Create">Crear primer incidente</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle module-table">
                <thead>
                    <tr>
                        <th>Problema</th>
                        <th>Reclamo</th>
                        <th>Sistema</th>
                        <th>Severidad</th>
                        <th>Estado</th>
                        <th>Activo</th>
                        <th>Creado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var incident in Model)
                {
                    <tr>
                        <td class="problem-cell">
                            <strong>@incident.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(incident.ProblemDescription))
                            {
                                <span>@incident.ProblemDescription</span>
                            }
                        </td>
                        <td>
                            <span class="source-chip">@incident.ClaimScope</span>
                            <span>@(incident.ClaimOwnerName ?? "Sin area/cliente")</span>
                        </td>
                        <td><span class="source-chip">@incident.SourceSystem</span></td>
                        <td><span class="severity-pill severity-@incident.Severity.ToLowerInvariant()">@incident.Severity</span></td>
                        <td><span class="status-chip">@incident.Status</span></td>
                        <td>
                            <strong>@(incident.MachineCode ?? "-")</strong>
                            <span>@(incident.LineCode ?? "Sin linea")</span>
                        </td>
                        <td>@incident.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Rca" asp-action="Details" asp-route-id="@incident.Id">Abrir</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
