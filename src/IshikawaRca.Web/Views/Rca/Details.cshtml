            "Supplier" => "Proveedor",
            _ => source
        };
    }

    private static string GetTimelineDetail(IshikawaRca.Contracts.Rca.RcaDomainEventDto timelineEvent)
    {
        var data = timelineEvent.Data;

        if (data.TryGetValue("title", out var title) && !string.IsNullOrWhiteSpace(title))
        {
            return title;
        }

        if (data.TryGetValue("actorName", out var actorName) && !string.IsNullOrWhiteSpace(actorName))
        {
            return actorName;
        }

        if (data.TryGetValue("actorType", out var actorType) && !string.IsNullOrWhiteSpace(actorType))
        {
            return actorType;
        }

        return timelineEvent.SourceSystem;
    }

    private static string FormatFileSize(long? bytes)
    {
        if (!bytes.HasValue)
        {
            return "-";
        }

        var value = bytes.Value;
        if (value >= 1024L * 1024L)
        {
            return $"{value / 1024d / 1024d:0.##} MB";
        }

        if (value >= 1024L)
        {
            return $"{value / 1024d:0.##} KB";
        }

        return $"{value} B";
    }

    private static bool IsImageContentType(string? contentType)
    {
        return !string.IsNullOrWhiteSpace(contentType) &&
               contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsVideoContentType(string? contentType)
    {
        return !string.IsNullOrWhiteSpace(contentType) &&
               contentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsPreviewableContentType(string? contentType)
    {
        if (string.IsNullOrWhiteSpace(contentType))
        {
            return false;
        }

        return contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) ||
               contentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase) ||
               contentType.StartsWith("text/", StringComparison.OrdinalIgnoreCase) ||
               contentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase) ||
               contentType.Equals("application/json", StringComparison.OrdinalIgnoreCase) ||
               contentType.Equals("application/xml", StringComparison.OrdinalIgnoreCase) ||
               contentType.Equals("text/csv", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetAttachmentPreviewKind(string? fileName, string? contentType)
    {
        var extension = (System.IO.Path.GetExtension(fileName) ?? string.Empty)
            .TrimStart('.')
            .ToLowerInvariant();

        if (IsImageContentType(contentType))
        {
            return "image";
        }

        if (IsVideoContentType(contentType))
        {
            return "video";
        }

        if (contentType?.Equals("application/pdf", StringComparison.OrdinalIgnoreCase) == true ||
            extension == "pdf")
        {
            return "pdf";
        }

        if (contentType?.StartsWith("text/", StringComparison.OrdinalIgnoreCase) == true ||
            contentType?.Equals("application/json", StringComparison.OrdinalIgnoreCase) == true ||
            contentType?.Equals("application/xml", StringComparison.OrdinalIgnoreCase) == true ||
            extension is "txt" or "csv" or "json" or "xml" or "log")
        {
            return "text";
        }

        if (extension is "doc" or "docx" or "xls" or "xlsx" or "ppt" or "pptx" or "odt" or "ods" or "odp")
        {
            return "office";
        }

        return "file";
    }

    private static string GetAttachmentPreviewLabel(string previewKind)
    {
        return previewKind switch
        {
            "pdf" => "PDF",
            "text" => "Texto",
            "office" => "Office",
            "video" => "Video",
            "image" => "Imagen",
            _ => "Archivo"
        };
    }

    private static string GetAttachmentExtension(string? fileName, string? contentType)
    {
        var extension = System.IO.Path.GetExtension(fileName);
        if (!string.IsNullOrWhiteSpace(extension))
        {
            return extension.TrimStart('.').ToUpperInvariant();
        }

        if (!string.IsNullOrWhiteSpace(contentType) && contentType.Contains('/'))
        {
            return contentType[(contentType.IndexOf('/') + 1)..].ToUpperInvariant();
        }

        return "FILE";
    }

    private static string GetCompactFileName(string? fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName))
        {
            return "Archivo";
        }

        const int maxLength = 34;
        if (fileName.Length <= maxLength)
        {
            return fileName;
        }

        var extension = System.IO.Path.GetExtension(fileName);
        var baseName = System.IO.Path.GetFileNameWithoutExtension(fileName);
        var baseLimit = Math.Max(12, maxLength - extension.Length - 3);
        var compactBase = baseName.Length > baseLimit ? baseName[..baseLimit] : baseName;

        return $"{compactBase}...{extension}";
    }

    private static string GetShortHash(string hash)
    {
        return hash.Length > 20 ? $"{hash[..12]}...{hash[^8..]}" : hash;
    }

