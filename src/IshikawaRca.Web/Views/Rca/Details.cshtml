            new SelectListItem("Manual", "Manual"),
            new SelectListItem("Operador", "Operator"),
            new SelectListItem("Calidad", "Quality"),
            new SelectListItem("Mantenimiento", "Maintenance"),
            new SelectListItem("SCADA", "SCADA"),
            new SelectListItem("OEE", "OEE"),
            new SelectListItem("Gantt", "GANTT"),
            new SelectListItem("Cliente", "Customer"),
            new SelectListItem("Proveedor", "Supplier")
        ];
    }

    private static string GetFactTypeLabel(string factType)
    {
        return factType switch
        {
            "Alarm" => "Alarma",
            "Measurement" => "Medicion",
            "Stop" => "Parada",
            "Inspection" => "Inspeccion",
