@model IshikawaRca.Web.Models.Rca.RcaIncidentDetailsViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Detalle RCA";
    var incident = Model.Incident;
    var causesByBranch = Model.Canvas.Causes
        .GroupBy(x => x.BranchId)
        .ToDictionary(x => x.Key, x => x.ToList());
    var causesById = Model.Canvas.Causes.ToDictionary(x => x.Id);
    var rootCause = Model.Canvas.Causes.FirstOrDefault(x => x.IsRootCause);
    var now = DateTimeOffset.UtcNow;
    var openActions = Model.CorrectiveActions.Count(x => !string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase) && !string.Equals(x.Status, "Cancelled", StringComparison.OrdinalIgnoreCase));
    var overdueActions = Model.CorrectiveActions.Count(x =>
        !string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(x.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) &&
        x.DueDate.HasValue &&
        x.DueDate.Value < now);
    var nextActionDue = Model.CorrectiveActions
        .Where(x =>
            !string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(x.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) &&
            x.DueDate.HasValue)
        .OrderBy(x => x.DueDate)
        .FirstOrDefault();
    var rootResolutionActions = Model.CorrectiveActions
        .Where(x => string.Equals(x.ResolutionScope, "RootCause", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var escapeResolutionActions = Model.CorrectiveActions
        .Where(x => string.Equals(x.ResolutionScope, "Escape", StringComparison.OrdinalIgnoreCase))
        .ToList();
    var correctiveActions = Model.CorrectiveActions
        .Where(x => string.Equals(x.ActionType, "Corrective", StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.DueDate ?? DateTimeOffset.MaxValue)
        .ThenBy(x => x.Title)
        .ToList();
    var preventiveActions = Model.CorrectiveActions
        .Where(x => string.Equals(x.ActionType, "Preventive", StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.DueDate ?? DateTimeOffset.MaxValue)
        .ThenBy(x => x.Title)
        .ToList();
    var recurrenceActions = Model.CorrectiveActions
        .Where(x => string.Equals(x.ActionType, "RecurrencePreventive", StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.DueDate ?? DateTimeOffset.MaxValue)
        .ThenBy(x => x.Title)
        .ToList();
    var capaLanes = new[]
    {
        new { Title = "Correctiva", Subtitle = "Contencion y correccion directa", Actions = correctiveActions, Tone = "corrective" },
        new { Title = "Preventiva", Subtitle = "Evita repeticion por proceso", Actions = preventiveActions, Tone = "preventive" },
        new { Title = "Recurrencia", Subtitle = "Sostiene el aprendizaje RCA", Actions = recurrenceActions, Tone = "recurrence" }
    };
    var wizardSteps = new[]
    {
        new { Key = "Problem", Label = "Problema", Detail = "Contexto y alcance" },
        new { Key = "Causes", Label = "Causas", Detail = "Hipotesis Ishikawa" },
        new { Key = "Evidence", Label = "Evidencias", Detail = "Datos y anexos" },
        new { Key = "Actions", Label = "Acciones", Detail = "Plan correctivo" },
        new { Key = "Validation", Label = "Validacion", Detail = "Eficacia confirmada" },
        new { Key = "Closed", Label = "Cierre", Detail = "RCA formalizado" }
    };
    var currentWizardIndex = Array.FindIndex(wizardSteps, x => string.Equals(x.Key, incident.WizardStep, StringComparison.OrdinalIgnoreCase));
    currentWizardIndex = currentWizardIndex < 0 ? 0 : currentWizardIndex;
    var wizardProgress = Model.WizardProgress;
    var currentWizardLabel = wizardSteps[currentWizardIndex].Label;
    var containmentAge = now - incident.OccurredAt;
    var containmentAgeLabel = incident.ClosedAt.HasValue
        ? $"{Math.Max(0, (int)Math.Floor((incident.ClosedAt.Value - incident.OccurredAt).TotalDays))}d"
        : containmentAge.TotalDays >= 1
            ? $"{(int)Math.Floor(containmentAge.TotalDays)}d"
            : $"{Math.Max(0, (int)Math.Floor(containmentAge.TotalHours))}h";
    var recurrenceRisk = overdueActions > 0
        ? "Alto"
        : rootCause is null || openActions > 0
            ? "Medio"
            : "Bajo";
    var recurrenceRiskClass = recurrenceRisk.ToLowerInvariant();
}

<section class="rca-command-center">
    <div class="command-copy">
        <div class="command-eyebrow">
            <span>@incident.SourceSystem</span>
            <span>@incident.ClaimActorType</span>
            <span>@incident.CreatedAt.LocalDateTime.ToString("dd/MM HH:mm")</span>
        </div>
        <h1>@incident.Title</h1>
        <p>@(incident.ProblemDescription ?? "Sin descripcion cargada.")</p>
        <div class="command-context-strip" aria-label="Contexto industrial del RCA">
            <span><strong>Linea</strong>@(incident.LineCode ?? "-")</span>
            <span><strong>Maquina</strong>@(incident.MachineCode ?? "-")</span>
            <span><strong>OT</strong>@(incident.WorkOrderCode ?? "-")</span>
            <span><strong>Fase</strong>@currentWizardLabel</span>
            <span><strong>Owner</strong>@(incident.WizardStepCompletedByUserId ?? incident.ClosedByUserId ?? "Sin asignar")</span>
        </div>
    </div>
    <div class="command-actions">
        <div class="command-state-stack" aria-label="Estado principal del RCA">
            <span class="severity-pill severity-@incident.Severity.ToLowerInvariant()">@incident.Severity</span>
            <span class="status-chip">@incident.Status</span>
            <span class="phase-chip">@wizardProgress.CompletionPercent% RCA</span>
        </div>
        <div class="command-action-row">
            <a class="btn btn-primary" asp-controller="Rca" asp-action="ExportPdf" asp-route-id="@incident.Id">Exportar PDF</a>
            <a class="btn btn-outline-secondary" href="#capa-board">CAPA</a>
            <a class="btn btn-outline-secondary" asp-controller="Rca" asp-action="Index">Volver</a>
        </div>
    </div>
</section>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success premium-alert" role="status">@message</div>
}

@if (TempData["ExternalIntakeLink"] is string externalLink)
{
    <div class="alert alert-info premium-alert" role="status">
        Link externo creado:
        <a href="@externalLink" target="_blank" rel="noopener">@externalLink</a>
    </div>
}

<section class="metric-grid compact-metrics" aria-label="Resumen del RCA">
    <article class="metric-tile">
        <span class="metric-value">@incident.Severity</span>
        <strong>Severidad</strong>
        <p>Clasificacion inicial del evento.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@incident.ClaimActorType</span>
        <strong>Reclamo</strong>
        <p>@(incident.ClaimOwnerName ?? "Sin origen de reclamo.")</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@Model.Canvas.Causes.Count</span>
        <strong>Causas</strong>
        <p>Hipotesis cargadas en el canvas.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@Model.Evidence.Count</span>
        <strong>Evidencias</strong>
        <p>Registros anexados al analisis.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@openActions</span>
        <strong>Acciones abiertas</strong>
        <p>@overdueActions vencidas; @(nextActionDue?.DueDate?.LocalDateTime.ToString("dd/MM HH:mm") ?? "sin proximo vencimiento").</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@(rootCause is null ? "Pend." : "Raiz")</span>
        <strong>Causa raiz</strong>
        <p>@(rootCause?.Title ?? "Aun sin confirmar.")</p>
    </article>
    <article class="metric-tile cockpit-metric">
        <span class="metric-value">@containmentAgeLabel</span>
        <strong>Edad de contencion</strong>
        <p>Desde el evento reportado hasta el estado actual.</p>
    </article>
    <article class="metric-tile cockpit-metric risk-@recurrenceRiskClass">
        <span class="metric-value">@recurrenceRisk</span>
        <strong>Riesgo de recurrencia</strong>
        <p>@(overdueActions > 0 ? "Hay acciones vencidas." : rootCause is null ? "Falta confirmar causa raiz." : openActions > 0 ? "Quedan acciones abiertas." : "Cierre operacional sin bloqueos visibles.")</p>
    </article>
</section>

<section class="analysis-panel wizard-panel">
    <div class="panel-heading">
        <div>
            <h2>Wizard RCA</h2>
            <span>Flujo guiado independiente y listo para integrarse con Gantt, AI y la app global</span>
        </div>
        <span class="canvas-counter">@wizardProgress.CompletionPercent%</span>
    </div>

    <ol class="wizard-rail" aria-label="Etapas del wizard RCA">
        @for (var i = 0; i < wizardSteps.Length; i++)
        {
            var step = wizardSteps[i];
            var state = i < currentWizardIndex ? "done" : i == currentWizardIndex ? "active" : "locked";
            <li class="wizard-step wizard-step-@state">
                <span class="wizard-index">@(i + 1)</span>
                <strong>@step.Label</strong>
                <small>@step.Detail</small>
            </li>
        }
    </ol>

    @if (wizardProgress.Steps.Count > 0)
    {
        <div class="wizard-guidance-grid" aria-label="Checklist del wizard RCA">
            <article class="wizard-summary-card">
                <span class="wizard-summary-value">@wizardProgress.CompletionPercent%</span>
                <strong>@wizardSteps[currentWizardIndex].Label</strong>
                <small>Proxima: @GetWizardStepLabel(wizardProgress.NextRecommendedStep)</small>
                <div class="wizard-progress-track">
                    <span style="width: @wizardProgress.CompletionPercent%"></span>
                </div>
            </article>

            <div class="wizard-checklist">
                @foreach (var item in wizardProgress.Steps)
                {
                    <section class="wizard-check-card wizard-check-@item.Status.ToLowerInvariant()">
                        <div class="wizard-check-heading">
                            <span>@item.Label</span>
                            <strong>@GetWizardStatusLabel(item.Status)</strong>
                        </div>
                        @if (item.Metrics.Count > 0)
                        {
                            <dl class="wizard-metrics">
                                @foreach (var metric in item.Metrics)
                                {
                                    <div>
                                        <dt>@metric.Key</dt>
                                        <dd>@metric.Value</dd>
                                    </div>
                                }
                            </dl>
                        }
                        @if (item.BlockingReasons.Count > 0)
                        {
                            <ul class="wizard-blockers">
                                @foreach (var blocker in item.BlockingReasons)
                                {
                                    <li>@blocker</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <small class="wizard-clearance">Listo para avanzar.</small>
                        }
                    </section>
                }
            </div>
        </div>
    }

    <form asp-controller="Rca" asp-action="CompleteWizardStep" asp-route-id="@incident.Id" method="post" class="wizard-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-grid">
            <div>
                <label asp-for="WizardForm.Step" class="form-label">Siguiente etapa</label>
                <select asp-for="WizardForm.Step" asp-items="Model.WizardStepOptions" class="form-select"></select>
                <span asp-validation-for="WizardForm.Step" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="WizardForm.CompletedByUserId" class="form-label">Completado por</label>
                <input asp-for="WizardForm.CompletedByUserId" class="form-control" />
            </div>
            <div>
                <label asp-for="WizardForm.Notes" class="form-label">Nota de avance</label>
                <input asp-for="WizardForm.Notes" class="form-control" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Completar etapa</button>
            </div>
        </div>
    </form>
</section>

<section class="detail-grid">
    <article class="detail-panel">
        <h2>Estado operativo</h2>
        <dl>
            <dt>Severidad</dt>
            <dd><span class="severity-pill severity-@incident.Severity.ToLowerInvariant()">@incident.Severity</span></dd>
            <dt>Estado RCA</dt>
            <dd>@incident.Status</dd>
            <dt>Wizard</dt>
            <dd>@wizardSteps[currentWizardIndex].Label</dd>
            <dt>Tipo de reclamo</dt>
            <dd>@incident.ClaimScope</dd>
            <dt>Actor</dt>
            <dd>@incident.ClaimActorType</dd>
            <dt>Area / cliente / proveedor</dt>
            <dd>@(incident.ClaimOwnerName ?? "-")</dd>
            <dt>Creado</dt>
            <dd>@incident.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt>Evento</dt>
            <dd>@incident.OccurredAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</dd>
            @if (incident.ClosedAt.HasValue)
            {
                <dt>Cerrado</dt>
                <dd>@incident.ClosedAt.Value.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</dd>
                <dt>Resumen</dt>
                <dd>@(incident.ClosureSummary ?? "Sin resumen.")</dd>
            }
        </dl>
    </article>

    <article class="detail-panel">
        <h2>Contexto industrial</h2>
        <dl>
            <dt>Maquina</dt>
            <dd>@(incident.MachineCode ?? "-")</dd>
            <dt>Linea</dt>
            <dd>@(incident.LineCode ?? "-")</dd>
            <dt>Orden</dt>
            <dd>@(incident.WorkOrderCode ?? "-")</dd>
            <dt>Escalado a 8D</dt>
            <dd>@(incident.EscalatedTo8D ? "Si" : "No")</dd>
            @if (incident.EscalatedTo8D)
            {
                <dt>Fecha 8D</dt>
                <dd>@(incident.EscalatedTo8DAt?.LocalDateTime.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                <dt>Motivo 8D</dt>
                <dd>@(incident.EscalationReason ?? "Sin motivo.")</dd>
            }
        </dl>
    </article>
</section>

@if (!incident.EscalatedTo8D && incident.Status != "Closed")
{
    <section class="analysis-panel close-panel">
        <div class="panel-heading">
            <div>
                <h2>Escalar a 8D</h2>
                <span>Elevar el RCA a disciplina 8D sin perder trazabilidad modular</span>
            </div>
            <span class="canvas-counter">8D</span>
        </div>
        <form asp-controller="Rca" asp-action="EscalateTo8D" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-grid">
                <div>
                    <label asp-for="EscalateForm.EscalatedByUserId" class="form-label">Escalado por</label>
                    <input asp-for="EscalateForm.EscalatedByUserId" class="form-control" />
                </div>
                <div>
                    <label asp-for="EscalateForm.EscalationReason" class="form-label">Motivo 8D</label>
                    <input asp-for="EscalateForm.EscalationReason" class="form-control" />
                    <span asp-validation-for="EscalateForm.EscalationReason" class="text-danger"></span>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-outline-secondary">Escalar a 8D</button>
                </div>
            </div>
        </form>
    </section>
}

@if (incident.Status != "Closed")
{
    <section class="analysis-panel close-panel">
        <div class="panel-heading">
            <div>
                <h2>Cierre RCA</h2>
                <span>Cierre formal con causa raiz y acciones validadas</span>
            </div>
            <span class="canvas-counter">@openActions accion(es) abierta(s)</span>
        </div>
        <form asp-controller="Rca" asp-action="Close" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-grid">
                <div>
                    <label asp-for="CloseForm.ClosedByUserId" class="form-label">Cerrado por</label>
                    <input asp-for="CloseForm.ClosedByUserId" class="form-control" />
                </div>
                <div>
                    <label asp-for="CloseForm.ClosureSummary" class="form-label">Resumen de cierre</label>
                    <input asp-for="CloseForm.ClosureSummary" class="form-control" />
                    <span asp-validation-for="CloseForm.ClosureSummary" class="text-danger"></span>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Cerrar RCA</button>
                </div>
            </div>
        </form>
    </section>
}

<section class="analysis-grid facts-grid">
    <article class="analysis-panel timeline-panel">
        <div class="panel-heading">
            <div>
                <h2>Linea de hechos</h2>
                <span>Secuencia manual de observaciones, mediciones, alarmas y contexto operativo</span>
            </div>
            <span class="canvas-counter">@Model.Facts.Count hecho(s)</span>
        </div>

        @if (Model.Facts.Count == 0)
        {
            <p class="muted-text">Sin hechos cargados. Registra primero lo observado antes de concluir causas.</p>
        }
        else
        {
            <ol class="timeline-list fact-list">
                @foreach (var fact in Model.Facts)
                {
                    var linkedCause = Model.Canvas.Causes.FirstOrDefault(x => x.Id == fact.CauseId);
                    var linkedEvidence = Model.Evidence.FirstOrDefault(x => x.Id == fact.EvidenceId);
                    var linkedAction = Model.CorrectiveActions.FirstOrDefault(x => x.Id == fact.CorrectiveActionId);
                    var linkedIntake = Model.ExternalIntakes.FirstOrDefault(x => x.Id == fact.ExternalIntakeId);

                    <li>
                        <span class="timeline-dot timeline-dot-fact"></span>
                        <div>
                            <strong>@fact.Title</strong>
                            <span>@fact.OccurredAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm") | @GetFactTypeLabel(fact.FactType) | @GetFactSourceLabel(fact.Source) | @GetFactSeverityLabel(fact.FactSeverity)</span>
                            @if (!string.IsNullOrWhiteSpace(fact.ShiftCode) ||
                                 !string.IsNullOrWhiteSpace(fact.MachineCode) ||
                                 !string.IsNullOrWhiteSpace(fact.LineCode) ||
                                 !string.IsNullOrWhiteSpace(fact.WorkOrderCode))
                            {
                                <small>
                                    @if (!string.IsNullOrWhiteSpace(fact.ShiftCode))
                                    {
                                        <text>Turno: @fact.ShiftCode. </text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(fact.MachineCode))
                                    {
                                        <text>Maquina: @fact.MachineCode. </text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(fact.LineCode))
                                    {
                                        <text>Linea: @fact.LineCode. </text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(fact.WorkOrderCode))
                                    {
                                        <text>OT: @fact.WorkOrderCode.</text>
                                    }
                                </small>
                            }
                            @if (!string.IsNullOrWhiteSpace(fact.AlarmCode) ||
                                 !string.IsNullOrWhiteSpace(fact.MaterialCode) ||
                                 !string.IsNullOrWhiteSpace(fact.BatchOrLot) ||
                                 !string.IsNullOrWhiteSpace(fact.MeasurementName))
                            {
                                <small>
                                    @if (!string.IsNullOrWhiteSpace(fact.AlarmCode))
                                    {
                                        <text>Alarma: @fact.AlarmCode. </text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(fact.MaterialCode))
                                    {
                                        <text>Material: @fact.MaterialCode. </text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(fact.BatchOrLot))
                                    {
                                        <text>Lote: @fact.BatchOrLot. </text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(fact.MeasurementName))
                                    {
                                        <text>Medicion: @fact.MeasurementName @(fact.MeasurementValue?.ToString("0.######") ?? "-") @fact.MeasurementUnit.</text>
                                    }
                                </small>
                            }
                            @if (!string.IsNullOrWhiteSpace(fact.Description))
                            {
                                <small>@fact.Description</small>
                            }
                            @if (linkedCause is not null || linkedEvidence is not null || linkedAction is not null || linkedIntake is not null || !string.IsNullOrWhiteSpace(fact.SourceDetail))
                            {
                                <small>
                                    @if (linkedCause is not null)
                                    {
                                        <text>Causa: @linkedCause.Title. </text>
                                    }
                                    @if (linkedEvidence is not null)
                                    {
                                        <text>Evidencia: @linkedEvidence.Title. </text>
                                    }
                                    @if (linkedAction is not null)
                                    {
                                        <text>Accion: @linkedAction.Title. </text>
                                    }
                                    @if (linkedIntake is not null)
                                    {
                                        <text>Intake: @(linkedIntake.ActorName ?? linkedIntake.ActorType). </text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(fact.SourceDetail))
                                    {
                                        <text>Fuente: @fact.SourceDetail.</text>
                                    }
                                </small>
                            }
                            @if (!string.IsNullOrWhiteSpace(fact.ExternalSourceSystem) ||
                                 !string.IsNullOrWhiteSpace(fact.ExternalEventId) ||
                                 !string.IsNullOrWhiteSpace(fact.ExternalRecordUri))
                            {
                                <small>
                                    @if (!string.IsNullOrWhiteSpace(fact.ExternalSourceSystem))
                                    {
                                        <text>Sistema externo: @fact.ExternalSourceSystem. </text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(fact.ExternalEventId))
                                    {
                                        <text>Evento: @fact.ExternalEventId. </text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(fact.ExternalRecordUri))
                                    {
                                        <text>Registro: @fact.ExternalRecordUri.</text>
                                    }
                                </small>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </article>

    <aside class="analysis-panel capture-panel">
        <h2>Nuevo hecho</h2>
        <form asp-controller="Rca" asp-action="AddFact" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="FactForm.Title" class="form-label">Hecho observado</label>
                <input asp-for="FactForm.Title" class="form-control" />
                <span asp-validation-for="FactForm.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FactForm.Description" class="form-label">Detalle</label>
                <textarea asp-for="FactForm.Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="form-grid fact-form-grid">
                <div>
                    <label asp-for="FactForm.OccurredAt" class="form-label">Fecha / hora</label>
                    <input asp-for="FactForm.OccurredAt" class="form-control" type="datetime-local" />
                </div>
                <div>
                    <label asp-for="FactForm.FactType" class="form-label">Tipo</label>
                    <select asp-for="FactForm.FactType" asp-items="GetFactTypeOptions()" class="form-select"></select>
                </div>
                <div>
                    <label asp-for="FactForm.FactSeverity" class="form-label">Severidad</label>
                    <select asp-for="FactForm.FactSeverity" asp-items="GetFactSeverityOptions()" class="form-select"></select>
                </div>
                <div>
                    <label asp-for="FactForm.Source" class="form-label">Fuente</label>
                    <select asp-for="FactForm.Source" asp-items="GetFactSourceOptions()" class="form-select"></select>
                </div>
                <div>
                    <label asp-for="FactForm.CapturedByUserId" class="form-label">Registrado por</label>
                    <input asp-for="FactForm.CapturedByUserId" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="FactForm.SourceDetail" class="form-label">Detalle fuente</label>
                <input asp-for="FactForm.SourceDetail" class="form-control" />
            </div>

            <div class="form-grid fact-form-grid">
                <div>
                    <label asp-for="FactForm.ExternalSourceSystem" class="form-label">Sistema externo</label>
                    <input asp-for="FactForm.ExternalSourceSystem" class="form-control" placeholder="SCADA / OEE / Gantt" />
                </div>
                <div>
                    <label asp-for="FactForm.ExternalEventId" class="form-label">ID evento externo</label>
                    <input asp-for="FactForm.ExternalEventId" class="form-control" />
                </div>
                <div>
                    <label asp-for="FactForm.ExternalRecordUri" class="form-label">URI registro externo</label>
                    <input asp-for="FactForm.ExternalRecordUri" class="form-control" />
                </div>
            </div>

            <div class="form-grid fact-form-grid">
                <div>
                    <label asp-for="FactForm.ShiftCode" class="form-label">Turno</label>
                    <input asp-for="FactForm.ShiftCode" class="form-control" />
                </div>
                <div>
                    <label asp-for="FactForm.MachineCode" class="form-label">Maquina</label>
                    <input asp-for="FactForm.MachineCode" class="form-control" />
                </div>
                <div>
                    <label asp-for="FactForm.LineCode" class="form-label">Linea</label>
                    <input asp-for="FactForm.LineCode" class="form-control" />
                </div>
                <div>
                    <label asp-for="FactForm.WorkOrderCode" class="form-label">OT</label>
                    <input asp-for="FactForm.WorkOrderCode" class="form-control" />
                </div>
                <div>
                    <label asp-for="FactForm.MaterialCode" class="form-label">Material</label>
                    <input asp-for="FactForm.MaterialCode" class="form-control" />
                </div>
                <div>
                    <label asp-for="FactForm.BatchOrLot" class="form-label">Lote</label>
                    <input asp-for="FactForm.BatchOrLot" class="form-control" />
                </div>
                <div>
                    <label asp-for="FactForm.AlarmCode" class="form-label">Alarma</label>
                    <input asp-for="FactForm.AlarmCode" class="form-control" />
                </div>
                <div>
                    <label asp-for="FactForm.MeasurementName" class="form-label">Medicion</label>
                    <input asp-for="FactForm.MeasurementName" class="form-control" />
                </div>
                <div>
                    <label asp-for="FactForm.MeasurementValue" class="form-label">Valor</label>
                    <input asp-for="FactForm.MeasurementValue" class="form-control" type="number" step="0.000001" />
                </div>
                <div>
                    <label asp-for="FactForm.MeasurementUnit" class="form-label">Unidad</label>
                    <input asp-for="FactForm.MeasurementUnit" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="FactForm.CauseId" class="form-label">Causa relacionada</label>
                <select asp-for="FactForm.CauseId" class="form-select">
                    <option value="">Sin causa especifica</option>
                    @foreach (var cause in Model.CauseOptions)
                    {
                        <option value="@cause.Value">@cause.Text</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="FactForm.EvidenceId" class="form-label">Evidencia relacionada</label>
                <select asp-for="FactForm.EvidenceId" class="form-select">
                    <option value="">Sin evidencia especifica</option>
                    @foreach (var evidence in Model.Evidence.OrderByDescending(x => x.CapturedAt))
                    {
                        <option value="@evidence.Id">@evidence.Title</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="FactForm.CorrectiveActionId" class="form-label">Accion relacionada</label>
                <select asp-for="FactForm.CorrectiveActionId" class="form-select">
                    <option value="">Sin accion especifica</option>
                    @foreach (var action in Model.CorrectiveActions.OrderBy(x => x.Status).ThenBy(x => x.Title))
                    {
                        <option value="@action.Id">@action.Title</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="FactForm.ExternalIntakeId" class="form-label">Intake externo relacionado</label>
                <select asp-for="FactForm.ExternalIntakeId" class="form-select">
                    <option value="">Sin intake externo</option>
                    @foreach (var intake in Model.ExternalIntakes.OrderByDescending(x => x.CreatedAt))
                    {
                        <option value="@intake.Id">@intake.ActorType / @(intake.ActorName ?? intake.ContactEmail ?? "Sin nombre")</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100">Agregar hecho</button>
        </form>
    </aside>
</section>

<section class="analysis-panel timeline-panel">
    <div class="panel-heading">
        <div>
            <h2>Timeline unificado</h2>
            <span>Hechos, evidencias, acciones, wizard e intake externo en una sola secuencia</span>
        </div>
        <span class="canvas-counter">@Model.UnifiedTimeline.Count evento(s)</span>
    </div>

    @if (Model.UnifiedTimeline.Count == 0)
    {
        <p class="muted-text">Sin eventos registrados.</p>
    }
    else
    {
        <div class="timeline-summary-grid" aria-label="Resumen del timeline RCA">
            <article>
                <strong>@Model.UnifiedTimeline.Count(x => x.Kind == "fact")</strong>
                <span>Hechos</span>
            </article>
            <article>
                <strong>@Model.UnifiedTimeline.Count(x => x.Kind == "evidence")</strong>
                <span>Evidencias</span>
            </article>
            <article>
                <strong>@Model.UnifiedTimeline.Count(x => x.Kind == "action")</strong>
                <span>Acciones</span>
            </article>
            <article>
                <strong>@Model.UnifiedTimeline.Count(x => x.Kind == "external")</strong>
                <span>Externos</span>
            </article>
        </div>

        <ol class="timeline-list unified-timeline-list">
            @foreach (var timelineEvent in Model.UnifiedTimeline)
            {
                <li>
                    <span class="timeline-dot timeline-dot-@timelineEvent.Kind"></span>
                    <div class="timeline-item-card timeline-item-@timelineEvent.Kind">
                        <div class="timeline-item-heading">
                            <div>
                                <strong>@timelineEvent.Label</strong>
                                <span>@timelineEvent.OccurredAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm") | @timelineEvent.SourceSystem</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(timelineEvent.Severity))
                            {
                                <small class="timeline-severity timeline-severity-@timelineEvent.Severity.ToLowerInvariant()">@GetFactSeverityLabel(timelineEvent.Severity)</small>
                            }
                        </div>
                        <p>@timelineEvent.Detail</p>
                        @if (timelineEvent.Badges.Count > 0)
                        {
                            <div class="timeline-chip-row" aria-label="Clasificacion del evento">
                                @foreach (var badge in timelineEvent.Badges)
                                {
                                    <span>@badge</span>
                                }
                            </div>
                        }
                        @if (timelineEvent.IndustrialContext.Count > 0)
                        {
                            <div class="timeline-context" aria-label="Contexto industrial">
                                @foreach (var context in timelineEvent.IndustrialContext)
                                {
                                    <small>@context</small>
                                }
                            </div>
                        }
                        @if (timelineEvent.References.Count > 0)
                        {
                            <div class="timeline-reference-row" aria-label="Referencias relacionadas">
                                @foreach (var reference in timelineEvent.References)
                                {
                                    <small>@reference</small>
                                }
                            </div>
                        }
                    </div>
                </li>
            }
        </ol>
    }
</section>

<section class="analysis-grid actions-grid" id="capa-board">
    <article class="analysis-panel">
        <div class="panel-heading">
            <div>
                <h2>Evidencias</h2>
                <span>Observaciones, documentos, sensores o referencias externas</span>
            </div>
            <span class="canvas-counter">@Model.Evidence.Count evidencia(s)</span>
        </div>

        @if (Model.Evidence.Count == 0)
        {
            <p class="muted-text">Sin evidencias cargadas.</p>
        }
        else
        {
            <div class="evidence-grid">
                @foreach (var evidence in Model.Evidence)
                {
                    var linkedCause = Model.Canvas.Causes.FirstOrDefault(x => x.Id == evidence.CauseId);
                    var hasAttachment = !string.IsNullOrWhiteSpace(evidence.AttachmentStorageKey);
                    var isImageAttachment = IsImageContentType(evidence.AttachmentContentType);
                    var isVideoAttachment = IsVideoContentType(evidence.AttachmentContentType);
                    var canPreviewAttachment = IsPreviewableContentType(evidence.AttachmentContentType);
                    var extensionLabel = GetAttachmentExtension(evidence.AttachmentFileName, evidence.AttachmentContentType);
                    var previewKind = GetAttachmentPreviewKind(evidence.AttachmentFileName, evidence.AttachmentContentType);
                    var previewLabel = GetAttachmentPreviewLabel(previewKind);

                    <section class="evidence-card @(hasAttachment ? "evidence-card-with-media" : string.Empty)">
                        @if (hasAttachment)
                        {
                            <a class="evidence-thumb"
                               data-preview-kind="@previewKind"
                               asp-controller="Rca"
                               asp-action="DownloadEvidence"
                               asp-route-id="@incident.Id"
                               asp-route-evidenceId="@evidence.Id"
                               aria-label="Descargar adjunto @(evidence.AttachmentFileName ?? evidence.Title)">
                                @if (isImageAttachment)
                                {
                                    <img src="@Url.Action("PreviewEvidence", "Rca", new { id = incident.Id, evidenceId = evidence.Id })" alt="Miniatura de @evidence.Title" loading="lazy" />
                                }
                                else if (isVideoAttachment)
                                {
                                    <video src="@Url.Action("PreviewEvidence", "Rca", new { id = incident.Id, evidenceId = evidence.Id })" muted preload="metadata" playsinline></video>
                                    <span class="evidence-thumb-badge">@extensionLabel</span>
                                }
                                else
                                {
                                    <span class="evidence-thumb-type">@extensionLabel</span>
                                    <small>@previewLabel</small>
                                }
                            </a>
                        }
                        <div class="evidence-card-body">
                            <div class="evidence-chip-row">
                                <span class="source-chip">@evidence.EvidenceType</span>
                                <span class="source-chip">@evidence.Source</span>
                                <span class="validation-chip validation-chip-@evidence.ValidationStatus.ToLowerInvariant()">@GetEvidenceValidationLabel(evidence.ValidationStatus)</span>
                            </div>
                            <strong>@evidence.Title</strong>
                            <span>@(linkedCause?.Title ?? "Sin causa asociada")</span>
                            @if (!string.IsNullOrWhiteSpace(evidence.SourceDetail))
                            {
                                <small>Fuente: @evidence.SourceDetail</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(evidence.Tags))
                            {
                                <div class="evidence-tag-row" aria-label="Tags de evidencia">
                                    @foreach (var tag in SplitEvidenceTags(evidence.Tags))
                                    {
                                        <span>#@tag</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(evidence.Summary))
                            {
                                <small>@evidence.Summary</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(evidence.ReferenceUri))
                            {
                                <a href="@evidence.ReferenceUri" target="_blank" rel="noopener">Abrir referencia</a>
                            }
                            @if (hasAttachment)
                            {
                                <div class="evidence-attachment-meta">
                                    <div class="evidence-file-actions">
                                        @if (canPreviewAttachment)
                                        {
                                            <a asp-controller="Rca" asp-action="PreviewEvidence" asp-route-id="@incident.Id" asp-route-evidenceId="@evidence.Id" target="_blank" rel="noopener">Vista previa</a>
                                        }
                                        <a asp-controller="Rca" asp-action="DownloadEvidence" asp-route-id="@incident.Id" asp-route-evidenceId="@evidence.Id">Descargar adjunto</a>
                                    </div>
                                    <small title="@evidence.AttachmentFileName">@GetCompactFileName(evidence.AttachmentFileName) &middot; @FormatFileSize(evidence.AttachmentSizeBytes) &middot; @(evidence.AttachmentContentType ?? "binario")</small>
                                    @if (!string.IsNullOrWhiteSpace(evidence.AttachmentSha256))
                                    {
                                        <small class="hash-line" title="@evidence.AttachmentSha256">SHA-256 @GetShortHash(evidence.AttachmentSha256)</small>
                                    }
                                </div>
                            }
                            <small>@evidence.CapturedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</small>
                            @if (!string.Equals(evidence.ValidationStatus, "PendingReview", StringComparison.OrdinalIgnoreCase))
                            {
                                <small>
                                    Validacion: @(evidence.ValidatedByUserId ?? "-")
                                    @if (evidence.ValidatedAt.HasValue)
                                    {
                                        <text> | @evidence.ValidatedAt.Value.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</text>
                                    }
                                </small>
                            }
                            @if (!string.IsNullOrWhiteSpace(evidence.ValidationNotes))
                            {
                                <small>@evidence.ValidationNotes</small>
                            }
                            <details class="evidence-manage">
                                <summary>Gestionar evidencia</summary>
                                <form class="evidence-edit-form" asp-controller="Rca" asp-action="UpdateEvidence" asp-route-id="@incident.Id" method="post">
                                    <input type="hidden" name="EvidenceEdit.EvidenceId" value="@evidence.Id" />
                                    <div class="evidence-form-grid">
                                        <label>
                                            <span>Titulo</span>
                                            <input class="form-control" name="EvidenceEdit.Title" value="@evidence.Title" maxlength="220" required />
                                        </label>
                                        <label>
                                            <span>Causa</span>
                                            <select class="form-select" name="EvidenceEdit.CauseId">
                                                <option value="" selected="@(evidence.CauseId is null ? "selected" : null)">Sin causa especifica</option>
                                                @foreach (var cause in Model.CauseOptions)
                                                {
                                                    <option value="@cause.Value" selected="@(cause.Value == evidence.CauseId?.ToString() ? "selected" : null)">@cause.Text</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>Tipo</span>
                                            <select class="form-select" name="EvidenceEdit.EvidenceType">
                                                @foreach (var option in GetEvidenceTypeOptions())
                                                {
                                                    <option value="@option.Value" selected="@(option.Value == evidence.EvidenceType ? "selected" : null)">@option.Text</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>Origen</span>
                                            <select class="form-select" name="EvidenceEdit.Source">
                                                @foreach (var option in GetEvidenceSourceOptions())
                                                {
                                                    <option value="@option.Value" selected="@(option.Value == evidence.Source ? "selected" : null)">@option.Text</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>Fuente detallada</span>
                                            <input class="form-control" name="EvidenceEdit.SourceDetail" value="@evidence.SourceDetail" maxlength="220" />
                                        </label>
                                        <label>
                                            <span>Tags</span>
                                            <input class="form-control" name="EvidenceEdit.Tags" value="@evidence.Tags" maxlength="500" />
                                        </label>
                                        <label>
                                            <span>Validacion</span>
                                            <select class="form-select" name="EvidenceEdit.ValidationStatus">
                                                @foreach (var option in GetEvidenceValidationStatusOptions())
                                                {
                                                    <option value="@option.Value" selected="@(option.Value == evidence.ValidationStatus ? "selected" : null)">@option.Text</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>Validador</span>
                                            <input class="form-control" name="EvidenceEdit.ValidatedByUserId" value="@evidence.ValidatedByUserId" maxlength="160" />
                                        </label>
                                    </div>
                                    <label>
                                        <span>Resumen</span>
                                        <textarea class="form-control" name="EvidenceEdit.Summary" rows="3" maxlength="4000">@evidence.Summary</textarea>
                                    </label>
                                    <label>
                                        <span>Nota de validacion</span>
                                        <textarea class="form-control" name="EvidenceEdit.ValidationNotes" rows="2" maxlength="2000">@evidence.ValidationNotes</textarea>
                                    </label>
                                    <label>
                                        <span>Referencia / URL</span>
                                        <input class="form-control" name="EvidenceEdit.ReferenceUri" value="@evidence.ReferenceUri" maxlength="1000" />
                                    </label>
                                    <div class="evidence-manage-actions">
                                        <button class="btn btn-primary" type="submit">Guardar cambios</button>
                                    </div>
                                </form>

                                <form class="evidence-replace-form" asp-controller="Rca" asp-action="ReplaceEvidenceAttachment" asp-route-id="@incident.Id" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="EvidenceAttachment.EvidenceId" value="@evidence.Id" />
                                    <label>
                                        <span>Reemplazar adjunto</span>
                                        <input class="form-control" name="EvidenceAttachment.Attachment" type="file" />
                                    </label>
                                    <div class="evidence-manage-actions">
                                        <button class="btn btn-secondary" type="submit">Reemplazar archivo</button>
                                    </div>
                                </form>

                                <form class="evidence-delete-form" asp-controller="Rca" asp-action="DeleteEvidence" asp-route-id="@incident.Id" asp-route-evidenceId="@evidence.Id" method="post">
                                    <button class="btn btn-danger" type="submit" onclick="return confirm('Eliminar esta evidencia del RCA?');">Eliminar evidencia</button>
                                </form>
                            </details>
                        </div>
                    </section>
                }
            </div>
        }
    </article>

    <aside class="analysis-panel capture-panel">
        <h2>Nueva evidencia</h2>
        <form asp-controller="Rca" asp-action="AddEvidence" asp-route-id="@incident.Id" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.Title" class="form-label">Titulo</label>
                <input asp-for="EvidenceForm.Title" class="form-control" />
                <span asp-validation-for="EvidenceForm.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.CauseId" class="form-label">Causa relacionada</label>
                <select asp-for="EvidenceForm.CauseId" class="form-select">
                    <option value="">Sin causa especifica</option>
                    @foreach (var cause in Model.CauseOptions)
                    {
                        <option value="@cause.Value">@cause.Text</option>
                    }
                </select>
            </div>

            <div class="score-grid">
                <div>
                    <label asp-for="EvidenceForm.EvidenceType" class="form-label">Tipo</label>
                    <select asp-for="EvidenceForm.EvidenceType" class="form-select">
                        <option value="Observation">Observacion</option>
                        <option value="Document">Documento</option>
                        <option value="Photo">Foto</option>
                        <option value="Sensor">Sensor</option>
                        <option value="Customer">Cliente</option>
                        <option value="Supplier">Proveedor</option>
                    </select>
                </div>
                <div>
                    <label asp-for="EvidenceForm.Source" class="form-label">Origen</label>
                    <select asp-for="EvidenceForm.Source" class="form-select">
                        <option value="Manual">Manual</option>
                        <option value="ExternalIntake">Intake externo</option>
                        <option value="SCADA">SCADA</option>
                        <option value="OEE">OEE</option>
                        <option value="GANTT">Gantt</option>
                    </select>
                </div>
                <div>
                    <label asp-for="EvidenceForm.CapturedByUserId" class="form-label">Usuario</label>
                    <input asp-for="EvidenceForm.CapturedByUserId" class="form-control" />
                </div>
            </div>

            <div class="mb-3 mt-3">
                <label asp-for="EvidenceForm.SourceDetail" class="form-label">Fuente detallada</label>
                <input asp-for="EvidenceForm.SourceDetail" class="form-control" placeholder="Equipo, lote, cliente, proveedor, sensor o documento origen" />
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.Tags" class="form-label">Tags</label>
                <input asp-for="EvidenceForm.Tags" class="form-control" placeholder="calidad, cliente, linea-2" />
                <small class="form-help">Separar por comas. Se guardan hasta 12 tags normalizados.</small>
            </div>

            <div class="score-grid">
                <div>
                    <label asp-for="EvidenceForm.ValidationStatus" class="form-label">Validacion</label>
                    <select asp-for="EvidenceForm.ValidationStatus" asp-items="GetEvidenceValidationStatusOptions()" class="form-select"></select>
                </div>
                <div>
                    <label asp-for="EvidenceForm.ValidatedByUserId" class="form-label">Validador</label>
                    <input asp-for="EvidenceForm.ValidatedByUserId" class="form-control" />
                </div>
                <div>
                    <label asp-for="EvidenceForm.ValidatedAt" class="form-label">Fecha validacion</label>
                    <input asp-for="EvidenceForm.ValidatedAt" class="form-control" type="datetime-local" />
                </div>
            </div>

            <div class="mb-3 mt-3">
                <label asp-for="EvidenceForm.Summary" class="form-label">Resumen</label>
                <textarea asp-for="EvidenceForm.Summary" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.ValidationNotes" class="form-label">Nota de validacion</label>
                <textarea asp-for="EvidenceForm.ValidationNotes" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.ReferenceUri" class="form-label">Referencia / URL</label>
                <input asp-for="EvidenceForm.ReferenceUri" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.Attachment" class="form-label">Adjunto</label>
                <input asp-for="EvidenceForm.Attachment" class="form-control" type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.webp,.gif,.mp4,.mov,.avi,.mkv,.webm" />
                <span asp-validation-for="EvidenceForm.Attachment" class="text-danger"></span>
                <small class="form-help">PDF, Office, CSV/TXT, imagenes y videos hasta 100 MB.</small>
            </div>

            <button type="submit" class="btn btn-primary w-100">Agregar evidencia</button>
        </form>
    </aside>
</section>

<section class="analysis-grid actions-grid">
    <article class="analysis-panel">
        <div class="panel-heading">
            <div>
                <h2>Intake externo</h2>
                <span>Links controlados para cliente o proveedor</span>
            </div>
            <span class="canvas-counter">@Model.ExternalIntakes.Count link(s)</span>
        </div>

        @if (Model.ExternalIntakes.Count == 0)
        {
            <p class="muted-text">Sin links externos creados.</p>
        }
        else
        {
            <div class="action-list">
                @foreach (var intake in Model.ExternalIntakes)
                {
                    <section class="action-row">
                        <div>
                            <strong>@intake.ActorType - @(intake.ActorName ?? "Sin actor")</strong>
                            <span>@(intake.ContactEmail ?? intake.ContactName ?? "Sin contacto")</span>
                            @if (!string.IsNullOrWhiteSpace(intake.Description))
                            {
                                <small>@intake.Description</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(intake.RejectionReason))
                            {
                                <small>Rechazo: @intake.RejectionReason</small>
                            }
                        </div>
                        <div>
                            <span class="status-chip">@intake.Status</span>
                            <small>Expira @intake.ExpiresAt.LocalDateTime.ToString("dd/MM/yyyy")</small>
                            @if (intake.Status is not "Revoked" and not "Submitted" and not "Reviewed" and not "Rejected")
                            {
                                <form asp-controller="Rca" asp-action="RevokeExternalIntake" asp-route-id="@incident.Id" method="post">
                                    <input type="hidden" name="intakeId" value="@intake.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Revocar</button>
                                </form>
                            }
                        </div>
                        @if (intake.Status == "Submitted")
                        {
                            <form class="external-review-form" asp-controller="Rca" asp-action="ReviewExternalIntake" asp-route-id="@incident.Id" method="post">
                                <input type="hidden" name="intakeId" value="@intake.Id" />
                                <div>
                                    <label class="form-label">Rama destino</label>
                                    <select name="branchId" class="form-select form-select-sm">
                                        @foreach (var branch in Model.BranchOptions)
                                        {
                                            <option value="@branch.Value">@branch.Text</option>
                                        }
                                    </select>
                                </div>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="importCause" value="true" checked />
                                    <span class="form-check-label">Importar causa</span>
                                </label>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="markCauseAsRoot" value="true" />
                                    <span class="form-check-label">Marcar raiz</span>
                                </label>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="importCorrectiveAction" value="true" checked />
                                    <span class="form-check-label">Importar accion</span>
                                </label>
                                <input class="form-control form-control-sm" name="reviewedByUserId" placeholder="Revisor" />
                                <button type="submit" class="btn btn-sm btn-primary">Aceptar respuesta</button>
                            </form>
                            <form class="external-reject-form" asp-controller="Rca" asp-action="RejectExternalIntake" asp-route-id="@incident.Id" method="post">
                                <input type="hidden" name="intakeId" value="@intake.Id" />
                                <input class="form-control form-control-sm" name="rejectionReason" placeholder="Motivo de rechazo" required />
