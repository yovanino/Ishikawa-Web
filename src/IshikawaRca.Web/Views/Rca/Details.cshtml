    </aside>
</section>

<section class="analysis-grid actions-grid">
    <article class="analysis-panel">
        <div class="panel-heading">
            <div>
                <h2>Intake externo</h2>
                <span>Links controlados para cliente o proveedor</span>
            </div>
            <span class="canvas-counter">@Model.ExternalIntakes.Count link(s)</span>
        </div>

        @if (Model.ExternalIntakes.Count == 0)
        {
            <p class="muted-text">Sin links externos creados.</p>
        }
        else
        {
            <div class="action-list">
                @foreach (var intake in Model.ExternalIntakes)
                {
                    <section class="action-row">
                        <div>
                            <strong>@intake.ActorType - @(intake.ActorName ?? "Sin actor")</strong>
                            <span>@(intake.ContactEmail ?? intake.ContactName ?? "Sin contacto")</span>
                            @if (!string.IsNullOrWhiteSpace(intake.Description))
                            {
                                <small>@intake.Description</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(intake.RejectionReason))
                            {
                                <small>Rechazo: @intake.RejectionReason</small>
                            }
                        </div>
                        <div>
                            <span class="status-chip">@intake.Status</span>
                            <small>Expira @intake.ExpiresAt.LocalDateTime.ToString("dd/MM/yyyy")</small>
                            @if (intake.Status is not "Revoked" and not "Submitted" and not "Reviewed" and not "Rejected")
                            {
                                <form asp-controller="Rca" asp-action="RevokeExternalIntake" asp-route-id="@incident.Id" method="post">
                                    <input type="hidden" name="intakeId" value="@intake.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Revocar</button>
                                </form>
                            }
                        </div>
                        @if (intake.Status == "Submitted")
                        {
                            <form class="external-review-form" asp-controller="Rca" asp-action="ReviewExternalIntake" asp-route-id="@incident.Id" method="post">
                                <input type="hidden" name="intakeId" value="@intake.Id" />
                                <div>
                                    <label class="form-label">Rama destino</label>
                                    <select name="branchId" class="form-select form-select-sm">
                                        @foreach (var branch in Model.BranchOptions)
                                        {
                                            <option value="@branch.Value">@branch.Text</option>
                                        }
                                    </select>
                                </div>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="importCause" value="true" checked />
                                    <span class="form-check-label">Importar causa</span>
                                </label>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="markCauseAsRoot" value="true" />
                                    <span class="form-check-label">Marcar raiz</span>
                                </label>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="importCorrectiveAction" value="true" checked />
                                    <span class="form-check-label">Importar accion</span>
                                </label>
                                <input class="form-control form-control-sm" name="reviewedByUserId" placeholder="Revisor" />
                                <button type="submit" class="btn btn-sm btn-primary">Aceptar respuesta</button>
                            </form>
                            <form class="external-reject-form" asp-controller="Rca" asp-action="RejectExternalIntake" asp-route-id="@incident.Id" method="post">
                                <input type="hidden" name="intakeId" value="@intake.Id" />
                                <input class="form-control form-control-sm" name="rejectionReason" placeholder="Motivo de rechazo" required />
                                <input class="form-control form-control-sm" name="rejectedByUserId" placeholder="Revisor" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Rechazar</button>
                            </form>
                        }
                    </section>
                }
            </div>
        }
