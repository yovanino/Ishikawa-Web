    <aside class="analysis-panel capture-panel">
        <h2>Crear link</h2>
        <form asp-controller="Rca" asp-action="CreateExternalIntake" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ExternalIntake.ActorType" class="form-label"></label>
                <select asp-for="ExternalIntake.ActorType" class="form-select">
                    <option value="Supplier">Proveedor</option>
                    <option value="Customer">Cliente</option>
                </select>
                <span asp-validation-for="ExternalIntake.ActorType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ExternalIntake.ActorName" class="form-label"></label>
                <input asp-for="ExternalIntake.ActorName" class="form-control" placeholder="Proveedor XYZ / Cliente ACME" />
            </div>

            <div class="mb-3">
                <label asp-for="ExternalIntake.ContactName" class="form-label"></label>
                <input asp-for="ExternalIntake.ContactName" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ExternalIntake.ContactEmail" class="form-label"></label>
                <input asp-for="ExternalIntake.ContactEmail" class="form-control" />
                <span asp-validation-for="ExternalIntake.ContactEmail" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Generar link externo</button>
