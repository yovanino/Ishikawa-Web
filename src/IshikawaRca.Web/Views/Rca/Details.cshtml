    <aside class="analysis-panel capture-panel">
        <h2>Nueva accion</h2>
        <form asp-controller="Rca" asp-action="AddAction" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Action.CauseId" class="form-label">Causa</label>
                <select asp-for="Action.CauseId" class="form-select">
                    <option value="">Sin causa especifica</option>
                    @foreach (var cause in Model.CauseOptions)
                    {
                        <option value="@cause.Value">@cause.Text</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Action.Title" class="form-label">Accion</label>
                <input asp-for="Action.Title" class="form-control" />
                <span asp-validation-for="Action.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Action.Description" class="form-label">Descripcion</label>
                <textarea asp-for="Action.Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Action.AssignedToUserId" class="form-label">Responsable</label>
                <input asp-for="Action.AssignedToUserId" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Action.DueDate" class="form-label">Vencimiento</label>
                <input asp-for="Action.DueDate" class="form-control" type="date" />
