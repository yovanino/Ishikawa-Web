@model IshikawaRca.Web.Models.Rca.RcaIncidentDetailsViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Detalle RCA";
    var incident = Model.Incident;
    var causesByBranch = Model.Canvas.Causes
        .GroupBy(x => x.BranchId)
        .ToDictionary(x => x.Key, x => x.ToList());
    var causesById = Model.Canvas.Causes.ToDictionary(x => x.Id);
    var rootCause = Model.Canvas.Causes.FirstOrDefault(x => x.IsRootCause);
    var openActions = Model.CorrectiveActions.Count(x => !string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase) && !string.Equals(x.Status, "Cancelled", StringComparison.OrdinalIgnoreCase));
    var wizardSteps = new[]
    {
        new { Key = "Problem", Label = "Problema", Detail = "Contexto y alcance" },
        new { Key = "Causes", Label = "Causas", Detail = "Hipotesis Ishikawa" },
        new { Key = "Evidence", Label = "Evidencias", Detail = "Datos y anexos" },
        new { Key = "Actions", Label = "Acciones", Detail = "Plan correctivo" },
        new { Key = "Validation", Label = "Validacion", Detail = "Eficacia confirmada" },
        new { Key = "Closed", Label = "Cierre", Detail = "RCA formalizado" }
    };
    var currentWizardIndex = Array.FindIndex(wizardSteps, x => string.Equals(x.Key, incident.WizardStep, StringComparison.OrdinalIgnoreCase));
    currentWizardIndex = currentWizardIndex < 0 ? 0 : currentWizardIndex;
}

<section class="rca-command-center">
    <div>
        <p class="module-kicker">@incident.SourceSystem | @incident.ClaimActorType</p>
        <h1>@incident.Title</h1>
        <p>@(incident.ProblemDescription ?? "Sin descripcion cargada.")</p>
    </div>
    <div class="command-actions">
        <span class="status-chip">@incident.Status</span>
        <a class="btn btn-outline-secondary" asp-controller="Rca" asp-action="Index">Volver</a>
    </div>
</section>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success premium-alert" role="status">@message</div>
}

@if (TempData["ExternalIntakeLink"] is string externalLink)
{
    <div class="alert alert-info premium-alert" role="status">
        Link externo creado:
        <a href="@externalLink" target="_blank" rel="noopener">@externalLink</a>
    </div>
}

<section class="metric-grid compact-metrics" aria-label="Resumen del RCA">
    <article class="metric-tile">
        <span class="metric-value">@incident.Severity</span>
        <strong>Severidad</strong>
        <p>Clasificacion inicial del evento.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@incident.ClaimActorType</span>
        <strong>Reclamo</strong>
        <p>@(incident.ClaimOwnerName ?? "Sin origen de reclamo.")</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@Model.Canvas.Causes.Count</span>
        <strong>Causas</strong>
        <p>Hipotesis cargadas en el canvas.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@Model.Evidence.Count</span>
        <strong>Evidencias</strong>
        <p>Registros anexados al analisis.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@openActions</span>
        <strong>Acciones abiertas</strong>
        <p>Trabajo correctivo pendiente.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@(rootCause is null ? "Pend." : "Raiz")</span>
        <strong>Causa raiz</strong>
        <p>@(rootCause?.Title ?? "Aun sin confirmar.")</p>
    </article>
</section>

<section class="analysis-panel wizard-panel">
    <div class="panel-heading">
        <div>
            <h2>Wizard RCA</h2>
            <span>Flujo guiado independiente y listo para integrarse con Gantt, AI y la app global</span>
        </div>
        <span class="canvas-counter">@wizardSteps[currentWizardIndex].Label</span>
    </div>

    <ol class="wizard-rail" aria-label="Etapas del wizard RCA">
        @for (var i = 0; i < wizardSteps.Length; i++)
        {
            var step = wizardSteps[i];
            var state = i < currentWizardIndex ? "done" : i == currentWizardIndex ? "active" : "locked";
            <li class="wizard-step wizard-step-@state">
                <span class="wizard-index">@(i + 1)</span>
                <strong>@step.Label</strong>
                <small>@step.Detail</small>
            </li>
        }
    </ol>

    <form asp-controller="Rca" asp-action="CompleteWizardStep" asp-route-id="@incident.Id" method="post" class="wizard-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-grid">
            <div>
                <label asp-for="WizardForm.Step" class="form-label">Etapa a completar</label>
                <select asp-for="WizardForm.Step" asp-items="Model.WizardStepOptions" class="form-select"></select>
                <span asp-validation-for="WizardForm.Step" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="WizardForm.CompletedByUserId" class="form-label">Completado por</label>
                <input asp-for="WizardForm.CompletedByUserId" class="form-control" />
            </div>
            <div>
                <label asp-for="WizardForm.Notes" class="form-label">Nota de avance</label>
                <input asp-for="WizardForm.Notes" class="form-control" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Completar etapa</button>
            </div>
        </div>
    </form>
</section>

<section class="detail-grid">
    <article class="detail-panel">
        <h2>Estado operativo</h2>
        <dl>
            <dt>Severidad</dt>
            <dd><span class="severity-pill severity-@incident.Severity.ToLowerInvariant()">@incident.Severity</span></dd>
            <dt>Estado RCA</dt>
            <dd>@incident.Status</dd>
            <dt>Wizard</dt>
            <dd>@wizardSteps[currentWizardIndex].Label</dd>
            <dt>Tipo de reclamo</dt>
            <dd>@incident.ClaimScope</dd>
            <dt>Actor</dt>
            <dd>@incident.ClaimActorType</dd>
            <dt>Area / cliente / proveedor</dt>
            <dd>@(incident.ClaimOwnerName ?? "-")</dd>
            <dt>Creado</dt>
            <dd>@incident.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt>Evento</dt>
            <dd>@incident.OccurredAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</dd>
            @if (incident.ClosedAt.HasValue)
            {
                <dt>Cerrado</dt>
                <dd>@incident.ClosedAt.Value.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</dd>
                <dt>Resumen</dt>
                <dd>@(incident.ClosureSummary ?? "Sin resumen.")</dd>
            }
        </dl>
    </article>

    <article class="detail-panel">
        <h2>Contexto industrial</h2>
        <dl>
            <dt>Maquina</dt>
            <dd>@(incident.MachineCode ?? "-")</dd>
            <dt>Linea</dt>
            <dd>@(incident.LineCode ?? "-")</dd>
            <dt>Orden</dt>
            <dd>@(incident.WorkOrderCode ?? "-")</dd>
            <dt>Escalado a 8D</dt>
            <dd>@(incident.EscalatedTo8D ? "Si" : "No")</dd>
            @if (incident.EscalatedTo8D)
            {
                <dt>Fecha 8D</dt>
                <dd>@(incident.EscalatedTo8DAt?.LocalDateTime.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                <dt>Motivo 8D</dt>
                <dd>@(incident.EscalationReason ?? "Sin motivo.")</dd>
            }
        </dl>
    </article>
</section>

@if (!incident.EscalatedTo8D && incident.Status != "Closed")
{
    <section class="analysis-panel close-panel">
        <div class="panel-heading">
            <div>
                <h2>Escalar a 8D</h2>
                <span>Elevar el RCA a disciplina 8D sin perder trazabilidad modular</span>
            </div>
            <span class="canvas-counter">8D</span>
        </div>
        <form asp-controller="Rca" asp-action="EscalateTo8D" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-grid">
                <div>
                    <label asp-for="EscalateForm.EscalatedByUserId" class="form-label">Escalado por</label>
                    <input asp-for="EscalateForm.EscalatedByUserId" class="form-control" />
                </div>
                <div>
                    <label asp-for="EscalateForm.EscalationReason" class="form-label">Motivo 8D</label>
                    <input asp-for="EscalateForm.EscalationReason" class="form-control" />
                    <span asp-validation-for="EscalateForm.EscalationReason" class="text-danger"></span>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-outline-secondary">Escalar a 8D</button>
                </div>
            </div>
        </form>
    </section>
}

@if (incident.Status != "Closed")
{
    <section class="analysis-panel close-panel">
        <div class="panel-heading">
            <div>
                <h2>Cierre RCA</h2>
                <span>Cierre formal con causa raiz y acciones validadas</span>
            </div>
            <span class="canvas-counter">@openActions accion(es) abierta(s)</span>
        </div>
        <form asp-controller="Rca" asp-action="Close" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-grid">
                <div>
                    <label asp-for="CloseForm.ClosedByUserId" class="form-label">Cerrado por</label>
                    <input asp-for="CloseForm.ClosedByUserId" class="form-control" />
                </div>
                <div>
                    <label asp-for="CloseForm.ClosureSummary" class="form-label">Resumen de cierre</label>
                    <input asp-for="CloseForm.ClosureSummary" class="form-control" />
                    <span asp-validation-for="CloseForm.ClosureSummary" class="text-danger"></span>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Cerrar RCA</button>
                </div>
            </div>
        </form>
    </section>
}

<section class="analysis-panel timeline-panel">
    <div class="panel-heading">
        <div>
            <h2>Timeline RCA</h2>
            <span>Eventos operativos e integraciones del analisis</span>
        </div>
        <span class="canvas-counter">@Model.TimelineEvents.Count evento(s)</span>
    </div>

    @if (Model.TimelineEvents.Count == 0)
    {
        <p class="muted-text">Sin eventos registrados.</p>
    }
    else
    {
        <ol class="timeline-list">
            @foreach (var timelineEvent in Model.TimelineEvents)
            {
                <li>
                    <span class="timeline-dot timeline-dot-@GetTimelineKind(timelineEvent.Type)"></span>
                    <div>
                        <strong>@GetTimelineLabel(timelineEvent.Type)</strong>
                        <span>@timelineEvent.OccurredAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                        <small>@GetTimelineDetail(timelineEvent)</small>
                    </div>
                </li>
            }
        </ol>
    }
</section>

<section class="analysis-grid actions-grid">
    <article class="analysis-panel">
        <div class="panel-heading">
            <div>
                <h2>Evidencias</h2>
                <span>Observaciones, documentos, sensores o referencias externas</span>
            </div>
            <span class="canvas-counter">@Model.Evidence.Count evidencia(s)</span>
        </div>

        @if (Model.Evidence.Count == 0)
        {
            <p class="muted-text">Sin evidencias cargadas.</p>
        }
        else
        {
            <div class="evidence-grid">
                @foreach (var evidence in Model.Evidence)
                {
                    var linkedCause = Model.Canvas.Causes.FirstOrDefault(x => x.Id == evidence.CauseId);
                    var hasAttachment = !string.IsNullOrWhiteSpace(evidence.AttachmentStorageKey);
                    var isImageAttachment = IsImageContentType(evidence.AttachmentContentType);
                    var isVideoAttachment = IsVideoContentType(evidence.AttachmentContentType);
                    var canPreviewAttachment = IsPreviewableContentType(evidence.AttachmentContentType);
                    var extensionLabel = GetAttachmentExtension(evidence.AttachmentFileName, evidence.AttachmentContentType);
                    var previewKind = GetAttachmentPreviewKind(evidence.AttachmentFileName, evidence.AttachmentContentType);
                    var previewLabel = GetAttachmentPreviewLabel(previewKind);

                    <section class="evidence-card @(hasAttachment ? "evidence-card-with-media" : string.Empty)">
                        @if (hasAttachment)
                        {
                            <a class="evidence-thumb"
                               data-preview-kind="@previewKind"
                               asp-controller="Rca"
                               asp-action="DownloadEvidence"
                               asp-route-id="@incident.Id"
                               asp-route-evidenceId="@evidence.Id"
                               aria-label="Descargar adjunto @(evidence.AttachmentFileName ?? evidence.Title)">
                                @if (isImageAttachment)
                                {
                                    <img src="@Url.Action("PreviewEvidence", "Rca", new { id = incident.Id, evidenceId = evidence.Id })" alt="Miniatura de @evidence.Title" loading="lazy" />
                                }
                                else if (isVideoAttachment)
                                {
                                    <video src="@Url.Action("PreviewEvidence", "Rca", new { id = incident.Id, evidenceId = evidence.Id })" muted preload="metadata" playsinline></video>
                                    <span class="evidence-thumb-badge">@extensionLabel</span>
                                }
                                else
                                {
                                    <span class="evidence-thumb-type">@extensionLabel</span>
                                    <small>@previewLabel</small>
                                }
                            </a>
                        }
                        <div class="evidence-card-body">
                            <div class="evidence-chip-row">
                                <span class="source-chip">@evidence.EvidenceType</span>
                                <span class="source-chip">@evidence.Source</span>
                                <span class="validation-chip validation-chip-@evidence.ValidationStatus.ToLowerInvariant()">@GetEvidenceValidationLabel(evidence.ValidationStatus)</span>
                            </div>
                            <strong>@evidence.Title</strong>
                            <span>@(linkedCause?.Title ?? "Sin causa asociada")</span>
                            @if (!string.IsNullOrWhiteSpace(evidence.SourceDetail))
                            {
                                <small>Fuente: @evidence.SourceDetail</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(evidence.Tags))
                            {
                                <div class="evidence-tag-row" aria-label="Tags de evidencia">
                                    @foreach (var tag in SplitEvidenceTags(evidence.Tags))
                                    {
                                        <span>#@tag</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(evidence.Summary))
                            {
                                <small>@evidence.Summary</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(evidence.ReferenceUri))
                            {
                                <a href="@evidence.ReferenceUri" target="_blank" rel="noopener">Abrir referencia</a>
                            }
                            @if (hasAttachment)
                            {
                                <div class="evidence-attachment-meta">
                                    <div class="evidence-file-actions">
                                        @if (canPreviewAttachment)
                                        {
                                            <a asp-controller="Rca" asp-action="PreviewEvidence" asp-route-id="@incident.Id" asp-route-evidenceId="@evidence.Id" target="_blank" rel="noopener">Vista previa</a>
                                        }
                                        <a asp-controller="Rca" asp-action="DownloadEvidence" asp-route-id="@incident.Id" asp-route-evidenceId="@evidence.Id">Descargar adjunto</a>
                                    </div>
                                    <small title="@evidence.AttachmentFileName">@GetCompactFileName(evidence.AttachmentFileName) &middot; @FormatFileSize(evidence.AttachmentSizeBytes) &middot; @(evidence.AttachmentContentType ?? "binario")</small>
                                    @if (!string.IsNullOrWhiteSpace(evidence.AttachmentSha256))
                                    {
                                        <small class="hash-line" title="@evidence.AttachmentSha256">SHA-256 @GetShortHash(evidence.AttachmentSha256)</small>
                                    }
                                </div>
                            }
                            <small>@evidence.CapturedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</small>
                            @if (!string.Equals(evidence.ValidationStatus, "PendingReview", StringComparison.OrdinalIgnoreCase))
                            {
                                <small>
                                    Validacion: @(evidence.ValidatedByUserId ?? "-")
                                    @if (evidence.ValidatedAt.HasValue)
                                    {
                                        <text> | @evidence.ValidatedAt.Value.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</text>
                                    }
                                </small>
                            }
                            @if (!string.IsNullOrWhiteSpace(evidence.ValidationNotes))
                            {
                                <small>@evidence.ValidationNotes</small>
                            }
                            <details class="evidence-manage">
                                <summary>Gestionar evidencia</summary>
                                <form class="evidence-edit-form" asp-controller="Rca" asp-action="UpdateEvidence" asp-route-id="@incident.Id" method="post">
                                    <input type="hidden" name="EvidenceEdit.EvidenceId" value="@evidence.Id" />
                                    <div class="evidence-form-grid">
                                        <label>
                                            <span>Titulo</span>
                                            <input class="form-control" name="EvidenceEdit.Title" value="@evidence.Title" maxlength="220" required />
                                        </label>
                                        <label>
                                            <span>Causa</span>
                                            <select class="form-select" name="EvidenceEdit.CauseId">
                                                <option value="" selected="@(evidence.CauseId is null ? "selected" : null)">Sin causa especifica</option>
                                                @foreach (var cause in Model.CauseOptions)
                                                {
                                                    <option value="@cause.Value" selected="@(cause.Value == evidence.CauseId?.ToString() ? "selected" : null)">@cause.Text</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>Tipo</span>
                                            <select class="form-select" name="EvidenceEdit.EvidenceType">
                                                @foreach (var option in GetEvidenceTypeOptions())
                                                {
                                                    <option value="@option.Value" selected="@(option.Value == evidence.EvidenceType ? "selected" : null)">@option.Text</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>Origen</span>
                                            <select class="form-select" name="EvidenceEdit.Source">
                                                @foreach (var option in GetEvidenceSourceOptions())
                                                {
                                                    <option value="@option.Value" selected="@(option.Value == evidence.Source ? "selected" : null)">@option.Text</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>Fuente detallada</span>
                                            <input class="form-control" name="EvidenceEdit.SourceDetail" value="@evidence.SourceDetail" maxlength="220" />
                                        </label>
                                        <label>
                                            <span>Tags</span>
                                            <input class="form-control" name="EvidenceEdit.Tags" value="@evidence.Tags" maxlength="500" />
                                        </label>
                                        <label>
                                            <span>Validacion</span>
                                            <select class="form-select" name="EvidenceEdit.ValidationStatus">
                                                @foreach (var option in GetEvidenceValidationStatusOptions())
                                                {
                                                    <option value="@option.Value" selected="@(option.Value == evidence.ValidationStatus ? "selected" : null)">@option.Text</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>Validador</span>
                                            <input class="form-control" name="EvidenceEdit.ValidatedByUserId" value="@evidence.ValidatedByUserId" maxlength="160" />
                                        </label>
                                    </div>
                                    <label>
                                        <span>Resumen</span>
                                        <textarea class="form-control" name="EvidenceEdit.Summary" rows="3" maxlength="4000">@evidence.Summary</textarea>
                                    </label>
                                    <label>
                                        <span>Nota de validacion</span>
                                        <textarea class="form-control" name="EvidenceEdit.ValidationNotes" rows="2" maxlength="2000">@evidence.ValidationNotes</textarea>
                                    </label>
                                    <label>
                                        <span>Referencia / URL</span>
                                        <input class="form-control" name="EvidenceEdit.ReferenceUri" value="@evidence.ReferenceUri" maxlength="1000" />
                                    </label>
                                    <div class="evidence-manage-actions">
                                        <button class="btn btn-primary" type="submit">Guardar cambios</button>
                                    </div>
                                </form>

                                <form class="evidence-replace-form" asp-controller="Rca" asp-action="ReplaceEvidenceAttachment" asp-route-id="@incident.Id" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="EvidenceAttachment.EvidenceId" value="@evidence.Id" />
                                    <label>
                                        <span>Reemplazar adjunto</span>
                                        <input class="form-control" name="EvidenceAttachment.Attachment" type="file" />
                                    </label>
                                    <div class="evidence-manage-actions">
                                        <button class="btn btn-secondary" type="submit">Reemplazar archivo</button>
                                    </div>
                                </form>

                                <form class="evidence-delete-form" asp-controller="Rca" asp-action="DeleteEvidence" asp-route-id="@incident.Id" asp-route-evidenceId="@evidence.Id" method="post">
                                    <button class="btn btn-danger" type="submit" onclick="return confirm('Eliminar esta evidencia del RCA?');">Eliminar evidencia</button>
                                </form>
                            </details>
                        </div>
                    </section>
                }
            </div>
        }
    </article>

    <aside class="analysis-panel capture-panel">
        <h2>Nueva evidencia</h2>
        <form asp-controller="Rca" asp-action="AddEvidence" asp-route-id="@incident.Id" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.Title" class="form-label">Titulo</label>
                <input asp-for="EvidenceForm.Title" class="form-control" />
                <span asp-validation-for="EvidenceForm.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.CauseId" class="form-label">Causa relacionada</label>
                <select asp-for="EvidenceForm.CauseId" class="form-select">
                    <option value="">Sin causa especifica</option>
                    @foreach (var cause in Model.CauseOptions)
                    {
                        <option value="@cause.Value">@cause.Text</option>
                    }
                </select>
            </div>

            <div class="score-grid">
                <div>
                    <label asp-for="EvidenceForm.EvidenceType" class="form-label">Tipo</label>
                    <select asp-for="EvidenceForm.EvidenceType" class="form-select">
                        <option value="Observation">Observacion</option>
                        <option value="Document">Documento</option>
                        <option value="Photo">Foto</option>
                        <option value="Sensor">Sensor</option>
                        <option value="Customer">Cliente</option>
                        <option value="Supplier">Proveedor</option>
                    </select>
                </div>
                <div>
                    <label asp-for="EvidenceForm.Source" class="form-label">Origen</label>
                    <select asp-for="EvidenceForm.Source" class="form-select">
                        <option value="Manual">Manual</option>
                        <option value="ExternalIntake">Intake externo</option>
                        <option value="SCADA">SCADA</option>
                        <option value="OEE">OEE</option>
                        <option value="GANTT">Gantt</option>
                    </select>
                </div>
                <div>
                    <label asp-for="EvidenceForm.CapturedByUserId" class="form-label">Usuario</label>
                    <input asp-for="EvidenceForm.CapturedByUserId" class="form-control" />
                </div>
            </div>

            <div class="mb-3 mt-3">
                <label asp-for="EvidenceForm.SourceDetail" class="form-label">Fuente detallada</label>
                <input asp-for="EvidenceForm.SourceDetail" class="form-control" placeholder="Equipo, lote, cliente, proveedor, sensor o documento origen" />
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.Tags" class="form-label">Tags</label>
                <input asp-for="EvidenceForm.Tags" class="form-control" placeholder="calidad, cliente, linea-2" />
                <small class="form-help">Separar por comas. Se guardan hasta 12 tags normalizados.</small>
            </div>

            <div class="score-grid">
                <div>
                    <label asp-for="EvidenceForm.ValidationStatus" class="form-label">Validacion</label>
                    <select asp-for="EvidenceForm.ValidationStatus" asp-items="GetEvidenceValidationStatusOptions()" class="form-select"></select>
                </div>
                <div>
                    <label asp-for="EvidenceForm.ValidatedByUserId" class="form-label">Validador</label>
                    <input asp-for="EvidenceForm.ValidatedByUserId" class="form-control" />
                </div>
                <div>
                    <label asp-for="EvidenceForm.ValidatedAt" class="form-label">Fecha validacion</label>
                    <input asp-for="EvidenceForm.ValidatedAt" class="form-control" type="datetime-local" />
                </div>
            </div>

            <div class="mb-3 mt-3">
                <label asp-for="EvidenceForm.Summary" class="form-label">Resumen</label>
                <textarea asp-for="EvidenceForm.Summary" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.ValidationNotes" class="form-label">Nota de validacion</label>
                <textarea asp-for="EvidenceForm.ValidationNotes" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.ReferenceUri" class="form-label">Referencia / URL</label>
                <input asp-for="EvidenceForm.ReferenceUri" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.Attachment" class="form-label">Adjunto</label>
                <input asp-for="EvidenceForm.Attachment" class="form-control" type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.webp,.gif,.mp4,.mov,.avi,.mkv,.webm" />
                <span asp-validation-for="EvidenceForm.Attachment" class="text-danger"></span>
