    private static IReadOnlyList<SelectListItem> GetFactSeverityOptions()
    {
        return
        [
            new SelectListItem("Informativo", "Info"),
            new SelectListItem("Bajo", "Low"),
            new SelectListItem("Medio", "Medium"),
            new SelectListItem("Alto", "High"),
