@model IshikawaRca.Web.Models.Rca.RcaIncidentDetailsViewModel

@{
    ViewData["Title"] = "Detalle RCA";
    var incident = Model.Incident;
    var causesByBranch = Model.Canvas.Causes
        .GroupBy(x => x.BranchId)
        .ToDictionary(x => x.Key, x => x.ToList());
    var causesById = Model.Canvas.Causes.ToDictionary(x => x.Id);
    var rootCause = Model.Canvas.Causes.FirstOrDefault(x => x.IsRootCause);
    var openActions = Model.CorrectiveActions.Count(x => !string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase) && !string.Equals(x.Status, "Cancelled", StringComparison.OrdinalIgnoreCase));
    var wizardSteps = new[]
    {
        new { Key = "Problem", Label = "Problema", Detail = "Contexto y alcance" },
        new { Key = "Causes", Label = "Causas", Detail = "Hipotesis Ishikawa" },
        new { Key = "Evidence", Label = "Evidencias", Detail = "Datos y anexos" },
        new { Key = "Actions", Label = "Acciones", Detail = "Plan correctivo" },
        new { Key = "Validation", Label = "Validacion", Detail = "Eficacia confirmada" },
        new { Key = "Closed", Label = "Cierre", Detail = "RCA formalizado" }
    };
    var currentWizardIndex = Array.FindIndex(wizardSteps, x => string.Equals(x.Key, incident.WizardStep, StringComparison.OrdinalIgnoreCase));
    currentWizardIndex = currentWizardIndex < 0 ? 0 : currentWizardIndex;
}

<section class="rca-command-center">
    <div>
        <p class="module-kicker">@incident.SourceSystem | @incident.ClaimActorType</p>
        <h1>@incident.Title</h1>
        <p>@(incident.ProblemDescription ?? "Sin descripcion cargada.")</p>
    </div>
    <div class="command-actions">
        <span class="status-chip">@incident.Status</span>
        <a class="btn btn-outline-secondary" asp-controller="Rca" asp-action="Index">Volver</a>
    </div>
</section>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success premium-alert" role="status">@message</div>
}

@if (TempData["ExternalIntakeLink"] is string externalLink)
{
    <div class="alert alert-info premium-alert" role="status">
        Link externo creado:
        <a href="@externalLink" target="_blank" rel="noopener">@externalLink</a>
    </div>
}

<section class="metric-grid compact-metrics" aria-label="Resumen del RCA">
    <article class="metric-tile">
        <span class="metric-value">@incident.Severity</span>
        <strong>Severidad</strong>
        <p>Clasificacion inicial del evento.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@incident.ClaimActorType</span>
        <strong>Reclamo</strong>
        <p>@(incident.ClaimOwnerName ?? "Sin origen de reclamo.")</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@Model.Canvas.Causes.Count</span>
        <strong>Causas</strong>
        <p>Hipotesis cargadas en el canvas.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@Model.Evidence.Count</span>
        <strong>Evidencias</strong>
        <p>Registros anexados al analisis.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@openActions</span>
        <strong>Acciones abiertas</strong>
        <p>Trabajo correctivo pendiente.</p>
    </article>
    <article class="metric-tile">
        <span class="metric-value">@(rootCause is null ? "Pend." : "Raiz")</span>
        <strong>Causa raiz</strong>
        <p>@(rootCause?.Title ?? "Aun sin confirmar.")</p>
    </article>
</section>

<section class="analysis-panel wizard-panel">
    <div class="panel-heading">
        <div>
            <h2>Wizard RCA</h2>
            <span>Flujo guiado independiente y listo para integrarse con Gantt, AI y la app global</span>
        </div>
        <span class="canvas-counter">@wizardSteps[currentWizardIndex].Label</span>
    </div>

    <ol class="wizard-rail" aria-label="Etapas del wizard RCA">
        @for (var i = 0; i < wizardSteps.Length; i++)
        {
            var step = wizardSteps[i];
            var state = i < currentWizardIndex ? "done" : i == currentWizardIndex ? "active" : "locked";
            <li class="wizard-step wizard-step-@state">
                <span class="wizard-index">@(i + 1)</span>
                <strong>@step.Label</strong>
                <small>@step.Detail</small>
            </li>
        }
    </ol>

    <form asp-controller="Rca" asp-action="CompleteWizardStep" asp-route-id="@incident.Id" method="post" class="wizard-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-grid">
            <div>
                <label asp-for="WizardForm.Step" class="form-label">Etapa a completar</label>
                <select asp-for="WizardForm.Step" asp-items="Model.WizardStepOptions" class="form-select"></select>
                <span asp-validation-for="WizardForm.Step" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="WizardForm.CompletedByUserId" class="form-label">Completado por</label>
                <input asp-for="WizardForm.CompletedByUserId" class="form-control" />
            </div>
            <div>
                <label asp-for="WizardForm.Notes" class="form-label">Nota de avance</label>
                <input asp-for="WizardForm.Notes" class="form-control" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Completar etapa</button>
            </div>
        </div>
    </form>
</section>

<section class="detail-grid">
    <article class="detail-panel">
        <h2>Estado operativo</h2>
        <dl>
            <dt>Severidad</dt>
            <dd><span class="severity-pill severity-@incident.Severity.ToLowerInvariant()">@incident.Severity</span></dd>
            <dt>Estado RCA</dt>
            <dd>@incident.Status</dd>
            <dt>Wizard</dt>
            <dd>@wizardSteps[currentWizardIndex].Label</dd>
            <dt>Tipo de reclamo</dt>
            <dd>@incident.ClaimScope</dd>
            <dt>Actor</dt>
            <dd>@incident.ClaimActorType</dd>
            <dt>Area / cliente / proveedor</dt>
            <dd>@(incident.ClaimOwnerName ?? "-")</dd>
            <dt>Creado</dt>
            <dd>@incident.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt>Evento</dt>
            <dd>@incident.OccurredAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</dd>
            @if (incident.ClosedAt.HasValue)
            {
                <dt>Cerrado</dt>
                <dd>@incident.ClosedAt.Value.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</dd>
                <dt>Resumen</dt>
                <dd>@(incident.ClosureSummary ?? "Sin resumen.")</dd>
            }
        </dl>
    </article>

    <article class="detail-panel">
        <h2>Contexto industrial</h2>
        <dl>
            <dt>Maquina</dt>
            <dd>@(incident.MachineCode ?? "-")</dd>
            <dt>Linea</dt>
            <dd>@(incident.LineCode ?? "-")</dd>
            <dt>Orden</dt>
            <dd>@(incident.WorkOrderCode ?? "-")</dd>
            <dt>Escalado a 8D</dt>
            <dd>@(incident.EscalatedTo8D ? "Si" : "No")</dd>
            @if (incident.EscalatedTo8D)
            {
                <dt>Fecha 8D</dt>
                <dd>@(incident.EscalatedTo8DAt?.LocalDateTime.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                <dt>Motivo 8D</dt>
                <dd>@(incident.EscalationReason ?? "Sin motivo.")</dd>
            }
        </dl>
    </article>
</section>

@if (!incident.EscalatedTo8D && incident.Status != "Closed")
{
    <section class="analysis-panel close-panel">
        <div class="panel-heading">
            <div>
                <h2>Escalar a 8D</h2>
                <span>Elevar el RCA a disciplina 8D sin perder trazabilidad modular</span>
            </div>
            <span class="canvas-counter">8D</span>
        </div>
        <form asp-controller="Rca" asp-action="EscalateTo8D" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-grid">
                <div>
                    <label asp-for="EscalateForm.EscalatedByUserId" class="form-label">Escalado por</label>
                    <input asp-for="EscalateForm.EscalatedByUserId" class="form-control" />
                </div>
                <div>
                    <label asp-for="EscalateForm.EscalationReason" class="form-label">Motivo 8D</label>
                    <input asp-for="EscalateForm.EscalationReason" class="form-control" />
                    <span asp-validation-for="EscalateForm.EscalationReason" class="text-danger"></span>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-outline-secondary">Escalar a 8D</button>
                </div>
            </div>
        </form>
    </section>
}

@if (incident.Status != "Closed")
{
    <section class="analysis-panel close-panel">
        <div class="panel-heading">
            <div>
                <h2>Cierre RCA</h2>
                <span>Cierre formal con causa raiz y acciones validadas</span>
            </div>
            <span class="canvas-counter">@openActions accion(es) abierta(s)</span>
        </div>
        <form asp-controller="Rca" asp-action="Close" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-grid">
                <div>
                    <label asp-for="CloseForm.ClosedByUserId" class="form-label">Cerrado por</label>
                    <input asp-for="CloseForm.ClosedByUserId" class="form-control" />
                </div>
                <div>
                    <label asp-for="CloseForm.ClosureSummary" class="form-label">Resumen de cierre</label>
                    <input asp-for="CloseForm.ClosureSummary" class="form-control" />
                    <span asp-validation-for="CloseForm.ClosureSummary" class="text-danger"></span>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Cerrar RCA</button>
                </div>
            </div>
        </form>
    </section>
}

<section class="analysis-panel timeline-panel">
    <div class="panel-heading">
        <div>
            <h2>Timeline RCA</h2>
            <span>Eventos operativos e integraciones del analisis</span>
        </div>
        <span class="canvas-counter">@Model.TimelineEvents.Count evento(s)</span>
    </div>

    @if (Model.TimelineEvents.Count == 0)
    {
        <p class="muted-text">Sin eventos registrados.</p>
    }
    else
    {
        <ol class="timeline-list">
            @foreach (var timelineEvent in Model.TimelineEvents)
            {
                <li>
                    <span class="timeline-dot timeline-dot-@GetTimelineKind(timelineEvent.Type)"></span>
                    <div>
                        <strong>@GetTimelineLabel(timelineEvent.Type)</strong>
                        <span>@timelineEvent.OccurredAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                        <small>@GetTimelineDetail(timelineEvent)</small>
                    </div>
                </li>
            }
        </ol>
    }
</section>

<section class="analysis-grid actions-grid">
    <article class="analysis-panel">
        <div class="panel-heading">
            <div>
                <h2>Evidencias</h2>
                <span>Observaciones, documentos, sensores o referencias externas</span>
            </div>
            <span class="canvas-counter">@Model.Evidence.Count evidencia(s)</span>
        </div>

        @if (Model.Evidence.Count == 0)
        {
            <p class="muted-text">Sin evidencias cargadas.</p>
        }
        else
        {
            <div class="evidence-grid">
                @foreach (var evidence in Model.Evidence)
                {
                    var linkedCause = Model.Canvas.Causes.FirstOrDefault(x => x.Id == evidence.CauseId);

                    <section class="evidence-card">
                        <div>
                            <span class="source-chip">@evidence.EvidenceType</span>
                            <span class="source-chip">@evidence.Source</span>
                        </div>
                        <strong>@evidence.Title</strong>
                        <span>@(linkedCause?.Title ?? "Sin causa asociada")</span>
                        @if (!string.IsNullOrWhiteSpace(evidence.Summary))
                        {
                            <small>@evidence.Summary</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(evidence.ReferenceUri))
                        {
                            <a href="@evidence.ReferenceUri" target="_blank" rel="noopener">Abrir referencia</a>
                        }
                        <small>@evidence.CapturedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</small>
                    </section>
                }
            </div>
        }
    </article>

    <aside class="analysis-panel capture-panel">
        <h2>Nueva evidencia</h2>
        <form asp-controller="Rca" asp-action="AddEvidence" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.Title" class="form-label">Titulo</label>
                <input asp-for="EvidenceForm.Title" class="form-control" />
                <span asp-validation-for="EvidenceForm.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.CauseId" class="form-label">Causa relacionada</label>
                <select asp-for="EvidenceForm.CauseId" class="form-select">
                    <option value="">Sin causa especifica</option>
                    @foreach (var cause in Model.CauseOptions)
                    {
                        <option value="@cause.Value">@cause.Text</option>
                    }
                </select>
            </div>

            <div class="score-grid">
                <div>
                    <label asp-for="EvidenceForm.EvidenceType" class="form-label">Tipo</label>
                    <select asp-for="EvidenceForm.EvidenceType" class="form-select">
                        <option value="Observation">Observacion</option>
                        <option value="Document">Documento</option>
                        <option value="Photo">Foto</option>
                        <option value="Sensor">Sensor</option>
                        <option value="Customer">Cliente</option>
                        <option value="Supplier">Proveedor</option>
                    </select>
                </div>
                <div>
                    <label asp-for="EvidenceForm.Source" class="form-label">Origen</label>
                    <select asp-for="EvidenceForm.Source" class="form-select">
                        <option value="Manual">Manual</option>
                        <option value="ExternalIntake">Intake externo</option>
                        <option value="SCADA">SCADA</option>
                        <option value="OEE">OEE</option>
                        <option value="GANTT">Gantt</option>
                    </select>
                </div>
                <div>
                    <label asp-for="EvidenceForm.CapturedByUserId" class="form-label">Usuario</label>
                    <input asp-for="EvidenceForm.CapturedByUserId" class="form-control" />
                </div>
            </div>

            <div class="mb-3 mt-3">
                <label asp-for="EvidenceForm.Summary" class="form-label">Resumen</label>
                <textarea asp-for="EvidenceForm.Summary" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="EvidenceForm.ReferenceUri" class="form-label">Referencia / URL</label>
                <input asp-for="EvidenceForm.ReferenceUri" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary w-100">Agregar evidencia</button>
        </form>
    </aside>
</section>

<section class="analysis-grid actions-grid">
    <article class="analysis-panel">
        <div class="panel-heading">
            <div>
                <h2>Intake externo</h2>
                <span>Links controlados para cliente o proveedor</span>
            </div>
            <span class="canvas-counter">@Model.ExternalIntakes.Count link(s)</span>
        </div>

        @if (Model.ExternalIntakes.Count == 0)
        {
            <p class="muted-text">Sin links externos creados.</p>
        }
        else
        {
            <div class="action-list">
                @foreach (var intake in Model.ExternalIntakes)
                {
                    <section class="action-row">
                        <div>
                            <strong>@intake.ActorType - @(intake.ActorName ?? "Sin actor")</strong>
                            <span>@(intake.ContactEmail ?? intake.ContactName ?? "Sin contacto")</span>
                            @if (!string.IsNullOrWhiteSpace(intake.Description))
                            {
                                <small>@intake.Description</small>
                            }
                            @if (!string.IsNullOrWhiteSpace(intake.RejectionReason))
                            {
                                <small>Rechazo: @intake.RejectionReason</small>
                            }
                        </div>
                        <div>
                            <span class="status-chip">@intake.Status</span>
                            <small>Expira @intake.ExpiresAt.LocalDateTime.ToString("dd/MM/yyyy")</small>
                            @if (intake.Status is not "Revoked" and not "Submitted" and not "Reviewed" and not "Rejected")
                            {
                                <form asp-controller="Rca" asp-action="RevokeExternalIntake" asp-route-id="@incident.Id" method="post">
                                    <input type="hidden" name="intakeId" value="@intake.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Revocar</button>
                                </form>
                            }
                        </div>
                        @if (intake.Status == "Submitted")
                        {
                            <form class="external-review-form" asp-controller="Rca" asp-action="ReviewExternalIntake" asp-route-id="@incident.Id" method="post">
                                <input type="hidden" name="intakeId" value="@intake.Id" />
                                <div>
                                    <label class="form-label">Rama destino</label>
                                    <select name="branchId" class="form-select form-select-sm">
                                        @foreach (var branch in Model.BranchOptions)
                                        {
                                            <option value="@branch.Value">@branch.Text</option>
                                        }
                                    </select>
                                </div>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="importCause" value="true" checked />
                                    <span class="form-check-label">Importar causa</span>
                                </label>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="markCauseAsRoot" value="true" />
                                    <span class="form-check-label">Marcar raiz</span>
                                </label>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="importCorrectiveAction" value="true" checked />
                                    <span class="form-check-label">Importar accion</span>
                                </label>
                                <input class="form-control form-control-sm" name="reviewedByUserId" placeholder="Revisor" />
                                <button type="submit" class="btn btn-sm btn-primary">Aceptar respuesta</button>
                            </form>
                            <form class="external-reject-form" asp-controller="Rca" asp-action="RejectExternalIntake" asp-route-id="@incident.Id" method="post">
                                <input type="hidden" name="intakeId" value="@intake.Id" />
                                <input class="form-control form-control-sm" name="rejectionReason" placeholder="Motivo de rechazo" required />
                                <input class="form-control form-control-sm" name="rejectedByUserId" placeholder="Revisor" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Rechazar</button>
                            </form>
                        }
                    </section>
                }
            </div>
        }
    </article>

    <aside class="analysis-panel capture-panel">
        <h2>Crear link</h2>
        <form asp-controller="Rca" asp-action="CreateExternalIntake" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ExternalIntake.ActorType" class="form-label"></label>
                <select asp-for="ExternalIntake.ActorType" class="form-select">
                    <option value="Supplier">Proveedor</option>
                    <option value="Customer">Cliente</option>
                </select>
                <span asp-validation-for="ExternalIntake.ActorType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ExternalIntake.ActorName" class="form-label"></label>
                <input asp-for="ExternalIntake.ActorName" class="form-control" placeholder="Proveedor XYZ / Cliente ACME" />
            </div>

            <div class="mb-3">
                <label asp-for="ExternalIntake.ContactName" class="form-label"></label>
                <input asp-for="ExternalIntake.ContactName" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ExternalIntake.ContactEmail" class="form-label"></label>
                <input asp-for="ExternalIntake.ContactEmail" class="form-control" />
                <span asp-validation-for="ExternalIntake.ContactEmail" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Generar link externo</button>
        </form>
    </aside>
</section>

<section class="analysis-grid">
    <article class="analysis-panel ishikawa-panel">
        <div class="panel-heading">
            <div>
                <h2>Canvas Ishikawa</h2>
                <span>Ramas 6M, causas, evidencia y causa raiz</span>
            </div>
            <span class="canvas-counter">@Model.Canvas.Causes.Count causa(s)</span>
        </div>

        <div class="fishbone-board">
            <div class="fishbone-spine">
                <span>@Model.Canvas.ProblemTitle</span>
            </div>
            <div class="branch-grid">
                @foreach (var branch in Model.Canvas.Branches)
                {
                    var causes = causesByBranch.TryGetValue(branch.Id, out var branchCauses)
                        ? branchCauses
                        : new List<IshikawaRca.Contracts.Rca.IshikawaCauseDto>();

                    <section class="branch-lane">
                        <div class="branch-title-row">
                            <h3>@branch.Name</h3>
                            <span>@causes.Count</span>
                        </div>
                        @if (causes.Count == 0)
                        {
                            <p class="muted-text">Sin causas cargadas</p>
                        }
                        else
                        {
                            <ul class="cause-list">
                                @foreach (var cause in causes)
                                {
                                    causesById.TryGetValue(cause.ParentCauseId ?? Guid.Empty, out var parentCause);
                                    <li class="@(cause.IsRootCause ? "root-cause" : "")">
                                        <strong>@cause.Title</strong>
                                        <span>
                                            P@cause.ProbabilityScore I@cause.ImpactScore F@cause.FrequencyScore
                                            @if (parentCause is not null)
                                            {
                                                <text> | Subcausa de @parentCause.Title</text>
                                            }
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(cause.EvidenceSummary))
                                        {
                                            <small>@cause.EvidenceSummary</small>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }
            </div>
        </div>
    </article>

    <aside class="analysis-panel capture-panel">
        <h2>Nueva causa</h2>
        <form asp-controller="Rca" asp-action="AddCause" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Cause.BranchId" class="form-label">Rama</label>
                <select asp-for="Cause.BranchId" asp-items="Model.BranchOptions" class="form-select"></select>
                <span asp-validation-for="Cause.BranchId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cause.ParentCauseId" class="form-label">Causa padre</label>
                <select asp-for="Cause.ParentCauseId" class="form-select">
                    <option value="">Causa primaria</option>
                    @foreach (var cause in Model.CauseOptions)
                    {
                        <option value="@cause.Value">@cause.Text</option>
                    }
                </select>
                <span asp-validation-for="Cause.ParentCauseId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cause.Title" class="form-label">Causa</label>
                <input asp-for="Cause.Title" class="form-control" />
                <span asp-validation-for="Cause.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cause.Description" class="form-label">Descripcion</label>
                <textarea asp-for="Cause.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Cause.Description" class="text-danger"></span>
            </div>

            <div class="score-grid">
                <div>
                    <label asp-for="Cause.ProbabilityScore" class="form-label">Prob.</label>
                    <input asp-for="Cause.ProbabilityScore" class="form-control" type="number" min="0" max="5" />
                </div>
                <div>
                    <label asp-for="Cause.ImpactScore" class="form-label">Impacto</label>
                    <input asp-for="Cause.ImpactScore" class="form-control" type="number" min="0" max="5" />
                </div>
                <div>
                    <label asp-for="Cause.FrequencyScore" class="form-label">Frec.</label>
                    <input asp-for="Cause.FrequencyScore" class="form-control" type="number" min="0" max="5" />
                </div>
            </div>

            <div class="form-check mt-3">
                <input asp-for="Cause.IsRootCause" class="form-check-input" />
                <label asp-for="Cause.IsRootCause" class="form-check-label">Causa raiz</label>
            </div>

            <div class="mb-3 mt-3">
                <label asp-for="Cause.EvidenceSummary" class="form-label">Evidencia</label>
                <textarea asp-for="Cause.EvidenceSummary" class="form-control" rows="2"></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-100">Agregar causa</button>
        </form>
    </aside>
</section>

<section class="analysis-grid actions-grid">
    <article class="analysis-panel">
        <div class="panel-heading">
            <div>
                <h2>Acciones correctivas</h2>
                <span>Responsables, vencimientos y trazabilidad</span>
            </div>
            <span class="canvas-counter">@Model.CorrectiveActions.Count accion(es)</span>
        </div>

        @if (Model.CorrectiveActions.Count == 0)
        {
            <p class="muted-text">Sin acciones cargadas</p>
        }
        else
        {
            <div class="action-list">
                @foreach (var action in Model.CorrectiveActions)
                {
                    var linkedCause = Model.Canvas.Causes.FirstOrDefault(x => x.Id == action.CauseId);

                    <section class="action-row">
                        <div>
                            <strong>@action.Title</strong>
                            <span>@(linkedCause?.Title ?? "Sin causa asociada")</span>
                            @if (!string.IsNullOrWhiteSpace(action.ValidationNotes))
                            {
                                <small>@action.ValidationNotes</small>
                            }
                        </div>
                        <div>
                            <span class="status-chip">@action.Status</span>
                            <small>@(action.DueDate?.LocalDateTime.ToString("dd/MM/yyyy") ?? "Sin vencimiento")</small>
                            @if (action.CompletedAt.HasValue)
                            {
                                <small>Validada @action.CompletedAt.Value.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</small>
                            }
                        </div>
                        @if (action.Status is not "Completed" and not "Cancelled")
                        {
                            <form class="action-status-form" asp-controller="Rca" asp-action="UpdateActionStatus" asp-route-id="@incident.Id" method="post">
                                <input type="hidden" name="ActionId" value="@action.Id" />
                                <select name="Status" class="form-select form-select-sm">
                                    <option value="InProgress">En progreso</option>
                                    <option value="WaitingValidation">Esperando validacion</option>
                                    <option value="Completed">Completada</option>
                                    <option value="Cancelled">Cancelada</option>
                                </select>
                                <input class="form-control form-control-sm" name="CompletedByUserId" placeholder="Validador" />
                                <input class="form-control form-control-sm" name="ValidationNotes" placeholder="Evidencia o nota de validacion" />
                                <button type="submit" class="btn btn-sm btn-primary">Actualizar</button>
                            </form>
                        }
                    </section>
                }
            </div>
        }
    </article>

    <aside class="analysis-panel capture-panel">
        <h2>Nueva accion</h2>
        <form asp-controller="Rca" asp-action="AddAction" asp-route-id="@incident.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Action.CauseId" class="form-label">Causa</label>
                <select asp-for="Action.CauseId" class="form-select">
                    <option value="">Sin causa especifica</option>
                    @foreach (var cause in Model.CauseOptions)
                    {
                        <option value="@cause.Value">@cause.Text</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Action.Title" class="form-label">Accion</label>
                <input asp-for="Action.Title" class="form-control" />
                <span asp-validation-for="Action.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Action.Description" class="form-label">Descripcion</label>
                <textarea asp-for="Action.Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Action.AssignedToUserId" class="form-label">Responsable</label>
                <input asp-for="Action.AssignedToUserId" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Action.DueDate" class="form-label">Vencimiento</label>
                <input asp-for="Action.DueDate" class="form-control" type="date" />
            </div>

            <button type="submit" class="btn btn-primary w-100">Agregar accion</button>
        </form>
    </aside>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private static string GetTimelineKind(string eventType)
    {
        if (eventType.Contains("ExternalIntake", StringComparison.OrdinalIgnoreCase))
        {
            return "external";
        }

        if (eventType.Contains("Wizard", StringComparison.OrdinalIgnoreCase))
        {
            return "wizard";
        }

        if (eventType.Contains("Evidence", StringComparison.OrdinalIgnoreCase))
        {
            return "evidence";
        }

        if (eventType.Contains("Action", StringComparison.OrdinalIgnoreCase))
        {
            return "action";
        }

        if (eventType.Contains("RootCause", StringComparison.OrdinalIgnoreCase) ||
            eventType.Contains("Cause", StringComparison.OrdinalIgnoreCase))
        {
            return "cause";
        }

        return "incident";
    }

    private static string GetTimelineLabel(string eventType)
    {
        return eventType switch
        {
            "RcaIncidentCreated" => "Incidente creado",
            "RcaCauseCreated" => "Causa agregada",
            "RcaRootCauseSelected" => "Causa raiz seleccionada",
            "RcaCorrectiveActionCreated" => "Accion correctiva creada",
            "RcaCorrectiveActionCompleted" => "Accion correctiva completada",
            "RcaEscalatedTo8D" => "RCA escalado a 8D",
            "RcaWizardStepCompleted" => "Etapa de wizard completada",
            "RcaEvidenceAttached" => "Evidencia agregada",
            "RcaExternalIntakeCreated" => "Link externo creado",
            "RcaExternalIntakeOpened" => "Link externo abierto",
            "RcaExternalIntakeSubmitted" => "Respuesta externa enviada",
            "RcaExternalIntakeReviewed" => "Respuesta externa revisada",
            "RcaExternalIntakeRejected" => "Respuesta externa rechazada",
            "RcaExternalIntakeRevoked" => "Link externo revocado",
            "RcaExternalIntakeExpired" => "Link externo expirado",
            "RcaClosed" => "Incidente RCA cerrado",
            _ => eventType
        };
    }

    private static string GetTimelineDetail(IshikawaRca.Contracts.Rca.RcaDomainEventDto timelineEvent)
    {
        var data = timelineEvent.Data;

        if (data.TryGetValue("title", out var title) && !string.IsNullOrWhiteSpace(title))
        {
            return title;
        }

        if (data.TryGetValue("actorName", out var actorName) && !string.IsNullOrWhiteSpace(actorName))
        {
            return actorName;
        }

        if (data.TryGetValue("actorType", out var actorType) && !string.IsNullOrWhiteSpace(actorType))
        {
            return actorType;
        }

        return timelineEvent.SourceSystem;
    }
}
