<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ishikawa RCA</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IshikawaRca.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-topbar">
        <nav class="navbar navbar-expand-lg module-nav">
            <div class="container-fluid app-topbar-inner">
                <a class="navbar-brand brand-lockup" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">IR</span>
                    <span>
                        <strong>Ishikawa RCA</strong>
                        <small>Industrial root cause cockpit</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Abrir navegacion">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav module-tabs">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Cockpit</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Rca" asp-action="Index">Incidentes</a>
                        </li>
                    </ul>
                    <div class="topbar-status">
                        <span class="live-indicator"></span>
                        <span>Standalone</span>
                        <span class="topbar-divider"></span>
                        <span>AI Stub</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid app-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer app-footer">
        <div class="container-fluid app-footer-inner">
            <span>&copy; 2026 Ishikawa RCA Module</span>
            <span>API v1 ready</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
